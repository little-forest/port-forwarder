#-------------------------------------------------------------------------------
#- Main process ----------------------------------------------------------------
#-------------------------------------------------------------------------------
# テスト (bats) では関数定義のみを読み込む
[[ -n "$PFWD_SOURCE_ONLY" ]] && return 0

umask 077
__setup
_parse_args "$@"

[[ -z "$_NO_COLOR" && -z "$_NO_TTY" ]] && __setup_color
[[ -n "$_QUIET" ]] && __SILENT=yes

if [[ -n "$_OPT_VERSION" ]]; then
  _cmd_version
  exit "$_EXIT_OK"
fi

if [[ -n "$_OPT_HELP" ]]; then
  if [[ -n "$_SUBCMD_GIVEN" ]]; then
    _cmd_help "$_SUBCMD"
  else
    _cmd_help ''
  fi
  exit "$_EXIT_OK"
fi

case "$_SUBCMD" in
  version)
    _cmd_version ;;
  help)
    _cmd_help "${_ARGS[0]}" ;;
  config)
    _cmd_config ;;
  list)
    _check_prerequisites
    _config_setup
    _cmd_list ;;
  daemon)
    _check_prerequisites
    _config_setup
    _setup_runtime_dir
    _cmd_daemon ;;
  status)
    _check_prerequisites
    _config_setup
    _setup_runtime_dir
    _cmd_status ;;
  start)
    _check_prerequisites
    _config_setup
    _setup_runtime_dir
    _cmd_start ;;
  stop)
    _check_prerequisites
    _config_setup
    _setup_runtime_dir
    _cmd_stop ;;
  restart)
    _check_prerequisites
    _config_setup
    _setup_runtime_dir
    _cmd_restart ;;
  up)
    _check_prerequisites
    _config_setup
    _setup_runtime_dir
    _cmd_up ;;
  down)
    _check_prerequisites
    _config_setup
    _setup_runtime_dir
    _cmd_down ;;
  reload)
    _check_prerequisites
    _config_setup
    _setup_runtime_dir
    _cmd_reload ;;
  logs)
    _check_prerequisites
    _config_setup
    _setup_runtime_dir
    _cmd_logs ;;
  *)
    _usage "unknown subcommand: ${_SUBCMD}" ;;
esac
_RC=$?

exit "$_RC"

