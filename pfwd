#-------------------------------------------------------------------------------
#- Main process ----------------------------------------------------------------
#-------------------------------------------------------------------------------
# テスト (bats) では関数定義のみを読み込む
[[ -n "$PFWD_SOURCE_ONLY" ]] && return 0

__setup
_parse_args "$@"

[[ -z "$_NO_COLOR" && -z "$_NO_TTY" ]] && __setup_color
[[ -n "$_QUIET" ]] && __SILENT=yes

if [[ -n "$_OPT_VERSION" ]]; then
  _cmd_version
  exit "$_EXIT_OK"
fi

if [[ -n "$_OPT_HELP" ]]; then
  if [[ -n "$_SUBCMD_GIVEN" ]]; then
    _cmd_help "$_SUBCMD"
  else
    _cmd_help ''
  fi
  exit "$_EXIT_OK"
fi

case "$_SUBCMD" in
  version)
    _cmd_version ;;
  help)
    _cmd_help "${_ARGS[0]}" ;;
  config)
    _cmd_config ;;
  list)
    _check_prerequisites
    _config_setup
    _cmd_list ;;
  *)
    _usage "unknown subcommand: ${_SUBCMD}" ;;
esac

exit "$_EXIT_OK"

