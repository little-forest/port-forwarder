#{{{
_show_usage() { #{{{
  cat <<PFWD_USAGE
usage: ${__SCRIPT_NAME} <subcommand> [options] [entry...]

Persistent SSH port forwarding manager.

subcommands:
  start [name...]      start forwarding for the given entries (default: enabled entries)
  stop [name...]       stop forwarding for the given entries
  restart [name...]    stop and start again
  status [name...]     show connection status (default subcommand)
  list                 list entries defined in the config file
  daemon               run the monitoring daemon in the foreground
  up                   start the daemon in the background
  down                 stop the daemon and all sessions
  reload               reload the config file and apply the difference
  logs [name]          show logs (-f to follow)
  test [name...]       validate the config and check connectivity
  install-service      generate a systemd unit (Linux only)
  uninstall-service    remove the systemd unit (Linux only)
  config               show the config path, or create one with --init
  version              show version
  help [subcommand]    show help

common options:
  -c, --config <PATH>  use the specified config file
  -v, --verbose        verbose output to stderr (-vv for more)
  -q, --quiet          suppress everything but errors
      --no-color       disable colored output
  -h, --help           show help
  -V, --version        show version

Run '${__SCRIPT_NAME} help <subcommand>' for details.
PFWD_USAGE
}
#}}}

_usage() { #{{{
  [[ -n "$1" ]] && __show_error "$1"
  _show_usage >&2
  exit "$_EXIT_USAGE"
}
#}}}

_help_start() { #{{{
  cat <<PFWD_HELP
usage: ${__SCRIPT_NAME} start [name...]

Start forwarding for the given entries. With no name, all enabled entries are
started. The daemon must be running (see '${__SCRIPT_NAME} up').

Starting an entry that is already connected succeeds and reports [ SKIP ].
PFWD_HELP
}
#}}}

_help_stop() { #{{{
  cat <<PFWD_HELP
usage: ${__SCRIPT_NAME} stop [name...]

Stop forwarding for the given entries. With no name, all entries are stopped.
The daemon keeps running; use '${__SCRIPT_NAME} down' to stop the daemon itself.
PFWD_HELP
}
#}}}

_help_restart() { #{{{
  cat <<PFWD_HELP
