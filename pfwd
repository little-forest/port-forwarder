#-------------------------------------------------------------------------------
#- common functions ------------------------------------------------------------
#{{{
__setup() { #{{{
  tty -s || _NO_TTY=yes
}
#}}}

__setup_color() { #{{{
  local I
  local COLOR_MAP=(\
    BLACK 0 MAROON 1 GREEN 2 OLIVE 3 NAVY 4 PURPLE 5 TEAL 6 SILVER 7 GREY 8 \
    RED 9 LIME 10 YELLOW 11 BLUE 12 FUCHSIA 13 AQUA 14 WHITE 15 \
    MAGENTA 5 CYAN 6 PINK 218 ORANGE 214 DARK_ORANGE3 166 \
  )

  C_OFF=`tput sgr0`   # Reset attribute
  # shellcheck disable=SC2034
  C_BOLD=`tput bold`  # Bold mode
  # shellcheck disable=SC2034
  C_REV=`tput rev`    # Reverse mode
  # shellcheck disable=SC2034
  C_UL=`tput smul`    # Underline mode

  for ((I=0; I<${#COLOR_MAP[@]}; I+=2)); do
    eval "C_${COLOR_MAP[$I]}=\`tput setaf ${COLOR_MAP[(($I + 1))]}\`"
    eval "C_B_${COLOR_MAP[$I]}=\`tput bold\`\`tput setaf ${COLOR_MAP[(($I + 1))]}\`"
    eval "C_U_${COLOR_MAP[$I]}=\`tput smul\`\`tput setaf ${COLOR_MAP[(($I + 1))]}\`"
    eval "C_R_${COLOR_MAP[$I]}=\`tput bold\`\`tput rev\`\`tput setaf ${COLOR_MAP[(($I + 1))]}\`"
  done
}
#}}}

__script_end() { #{{{
  local FUNC
  while read -r FUNC; do
    $FUNC
  done < <(declare -F | sed -e 's/^declare -f //' | grep -E '^__?script_end_.+' | sort)
}
trap '__script_end' EXIT
#}}}

__show_info() { #{{{
  [[ -n "${__SILENT}" ]] && return
  [[ "$1" == "-n" ]] && echo -en "${C_CYAN}${2}${C_OFF}" || echo -e "${C_CYAN}${1}${C_OFF}"
}
#}}}

__show_error() { #{{{
  echo -e "[${C_RED} ERROR ${C_OFF}] $*" >&2
}
#}}}

__show_warn() { #{{{
  [[ -n "${__SILENT}" ]] && return
  echo -e "[${C_YELLOW} WARN ${C_OFF}] $*" >&2
}
#}}}

__error_end() { #{{{
  __show_error "$*"; exit 1
}
#}}}

__get_tmp_base() { #{{{
  local TMP_BASE RAMDISK
  if [[ `uname` != Darwin ]]; then
    RAMDISK='/dev/shm'
  else
    RAMDISK='/Volumes/Ramdisk'
  fi
  [[ -d ${RAMDISK} ]] && TMP_BASE=${RAMDISK}/ || TMP_BASE=${TMPDIR:-/tmp}/
  TMP_BASE="${TMP_BASE}tmp.`basename "$0"`.$$"
  [[ ! -d "$TMP_BASE" ]] && mkdir "$TMP_BASE"
  echo "$TMP_BASE"
}
#}}}

# shellcheck disable=SC2120  # 引数 -d は任意 (template.sh 由来)
__make_tmp() { #{{{
  local TMP_BASE
  TMP_BASE=`__get_tmp_base`
  local OPT=()
  [[ "$1" == '-d' ]] && OPT+=("$1")
  OPT+=('-p' "$TMP_BASE")
  mktemp "${OPT[@]}"
}
#}}}

__script_end_clean_tmp() { #{{{
  local TMP_BASE
  TMP_BASE="${TMPDIR:-/tmp}/tmp.`basename "$0"`.$$"
  [[ -d /dev/shm ]] && TMP_BASE="/dev/shm/tmp.`basename "$0"`.$$"
  [[ -d /Volumes/Ramdisk ]] && TMP_BASE="/Volumes/Ramdisk/tmp.`basename "$0"`.$$"
  [[ -d "$TMP_BASE" ]] && rm -rf "${TMP_BASE}"
  return 0
}
#}}}
#}}}

#-------------------------------------------------------------------------------
#- utility functions -----------------------------------------------------------
#{{{
# 現在時刻を epoch 秒で返す
_now() { #{{{
  if [[ -z "$_HAVE_PRINTF_TIME" ]]; then
    if printf '%(%s)T' -1 >/dev/null 2>&1; then _HAVE_PRINTF_TIME=yes; else _HAVE_PRINTF_TIME=no; fi
  fi
  if [[ "$_HAVE_PRINTF_TIME" == yes ]]; then
    printf '%(%s)T\n' -1
  else
    date +%s
  fi
}
#}}}

# ログ用のタイムスタンプ (SPECS 6.5)
_timestamp() { #{{{
  if [[ -z "$_HAVE_PRINTF_TIME" ]]; then
    if printf '%(%s)T' -1 >/dev/null 2>&1; then _HAVE_PRINTF_TIME=yes; else _HAVE_PRINTF_TIME=no; fi
  fi
  if [[ "$_HAVE_PRINTF_TIME" == yes ]]; then
    printf '%(%Y-%m-%dT%H:%M:%S%z)T\n' -1
  else
    date +%Y-%m-%dT%H:%M:%S%z
  fi
}
#}}}

# 経過秒数を "2d 04:11" / "05:22" 形式に整形する (SPECS 6.1)
_fmt_uptime() { #{{{
  local SEC=$1 D H M
  [[ ! "$SEC" =~ ^[0-9]+$ ]] && { printf '%s\n' '-'; return; }
  D=$(( SEC / 86400 ))
  H=$(( SEC % 86400 / 3600 ))
  M=$(( SEC % 3600 / 60 ))
  if (( D > 0 )); then
    printf '%dd %02d:%02d\n' "$D" "$H" "$M"
  else
    printf '%02d:%02d\n' "$H" "$M"
  fi
}
#}}}

# 先頭の ~ を $HOME に展開する
_expand_tilde() { #{{{
  local P=$1
  if [[ "${P:0:1}" == '~' ]]; then
    if (( ${#P} == 1 )); then
      P=$HOME
    elif [[ "${P:1:1}" == '/' ]]; then
      P="${HOME}${P:1}"
    fi
  fi
  printf '%s\n' "$P"
}
#}}}

# 配列に値が含まれるか
_in_array() { #{{{
  local NEEDLE=$1 V
  shift
  for V in "$@"; do
    [[ "$V" == "$NEEDLE" ]] && return 0
  done
  return 1
}
#}}}

# 幅を超える文字列を末尾 ... で切り詰める (SPECS 6.2)
_truncate() { #{{{
  local S=$1 W=$2
  if (( ${#S} > W )); then
    printf '%s...\n' "${S:0:$(( W - 3 ))}"
  else
    printf '%s\n' "$S"
  fi
}
#}}}

# 制御文字を空白に置換し、256 バイトで打ち切る (DESIGN 9)
_sanitize() { #{{{
  local S=$*
  S=${S//[[:cntrl:]]/ }
  (( ${#S} > 256 )) && S=${S:0:256}
  printf '%s\n' "$S"
}
#}}}

# 誤入力に最も近いエントリ名を返す (距離 3 以下)
_suggest_name() { #{{{
  local TARGET=$1
  (( ${#_CFG_NAMES[@]} == 0 )) && return 0
  printf '%s\n' "${_CFG_NAMES[@]}" | awk -v t="$TARGET" '
    function lev(s, u,   m, n, i, j, cost, x, y, z, d) {
      m = length(s); n = length(u)
      for (i = 0; i <= m; i++) d[i, 0] = i
      for (j = 0; j <= n; j++) d[0, j] = j
      for (i = 1; i <= m; i++) {
        for (j = 1; j <= n; j++) {
          cost = (substr(s, i, 1) == substr(u, j, 1)) ? 0 : 1
          x = d[i-1, j] + 1; y = d[i, j-1] + 1; z = d[i-1, j-1] + cost
          d[i, j] = (x < y) ? x : y
          if (z < d[i, j]) d[i, j] = z
        }
      }
      return d[m, n]
    }
    { c = lev(t, $0); if (best == "" || c < bd) { bd = c; best = $0 } }
    END { if (best != "" && bd <= 3) print best }'
  return 0
}
#}}}

# 終了コードを伴うエラー終了 (DESIGN 7.1)
_error_exit() { #{{{
  local CODE=$1
  shift
  __show_error "$*"
  exit "$CODE"
}
#}}}

# 実行結果を 1 行で表示する (DESIGN 2.3)
_show_result() { #{{{
  local RESULT=$1 NAME=$2
  shift 2
  [[ -n "$_QUIET" ]] && return 0
  local TAG COLOR
  case "$RESULT" in
    OK)     TAG='  OK  '; COLOR=$C_GREEN ;;
    FAILED) TAG='FAILED'; COLOR=$C_RED ;;
    WARN)   TAG=' WARN '; COLOR=$C_YELLOW ;;
    SKIP)   TAG=' SKIP '; COLOR=$C_GREY ;;
    *)      TAG=$RESULT;  COLOR= ;;
  esac
  printf '[%s%s%s] %-*s %s\n' "$COLOR" "$TAG" "$C_OFF" "$_NAME_WIDTH" "$NAME" "$*"
}
#}}}

# 対象エントリ名の最大長から表示幅を決める
_calc_name_width() { #{{{
  local N W=10
  for N in "$@"; do
    (( ${#N} > W )) && W=${#N}
  done
  _NAME_WIDTH=$W
}
#}}}
#}}}

#-------------------------------------------------------------------------------
#- logging functions -----------------------------------------------------------
#{{{
# ログ出力先を決定する。書き込めない場合は標準出力にフォールバックする
_log_init() { #{{{
  local F D
  F=${_GLOBAL[log_file]}
  if [[ -z "$F" ]]; then
    _LOG_FILE=
    return 0
  fi
  F=$(_expand_tilde "$F")
  D=$(dirname "$F")
  if [[ ! -d "$D" ]] && ! mkdir -p "$D" 2>/dev/null; then
    __show_warn "cannot create log directory: ${D} (logging to stdout)"
    _LOG_FILE=
    return 1
  fi
  if ! : >> "$F" 2>/dev/null; then
    __show_warn "cannot write log file: ${F} (logging to stdout)"
    _LOG_FILE=
    return 1
  fi
  _LOG_FILE=$F
  return 0
}
#}}}

# _log <LEVEL> <ENTRY|-> <MSG...>
_log() { #{{{
  local LEVEL=$1 ENTRY=$2
  shift 2
  local MSG LINE
  MSG=$(_sanitize "$*")
  if [[ "$ENTRY" == '-' ]]; then
    printf -v LINE '%s [%-5s] %s' "$(_timestamp)" "$LEVEL" "$MSG"
  else
    printf -v LINE '%s [%-5s] [%s] %s' "$(_timestamp)" "$LEVEL" "$ENTRY" "$MSG"
  fi
  if [[ -n "$_LOG_FILE" ]]; then
    printf '%s\n' "$LINE" >> "$_LOG_FILE"
  else
    printf '%s\n' "$LINE"
  fi
  return 0
}
#}}}

_log_info()  { _log 'INFO'  "$@"; }
_log_warn()  { _log 'WARN'  "$@"; }
_log_error() { _log 'ERROR' "$@"; }

# -v / -vv 指定時のみ標準エラー出力に出す (SPECS 3.2)
_debug() { #{{{
  (( _VERBOSE >= 1 )) || return 0
  printf '%s [DEBUG] %s\n' "$(_timestamp)" "$(_sanitize "$*")" >&2
  return 0
}
#}}}

_debug2() { #{{{
  (( _VERBOSE >= 2 )) || return 0
  printf '%s [DEBUG] %s\n' "$(_timestamp)" "$(_sanitize "$*")" >&2
  return 0
}
#}}}
