#-------------------------------------------------------------------------------
#- subcommand functions --------------------------------------------------------
#{{{
# エントリの SSH 接続先表記 (user@host[:port])
_ssh_label() { #{{{
  local NAME=$1 U H P L
  U=${_CFG[${NAME}.user]}
  H=${_CFG[${NAME}.host]}
  P=${_CFG[${NAME}.port]}
  [[ -n "$U" ]] && L="${U}@${H}" || L=$H
  [[ -n "$P" && "$P" != '22' ]] && L="${L}:${P}"
  printf '%s\n' "$L"
}
#}}}

_cmd_list() { #{{{
  local NAME EN
  _calc_name_width "${_CFG_NAMES[@]}"
  printf '%-*s  %-7s  %-27s  %-15s  %s\n' \
    "$_NAME_WIDTH" 'NAME' 'ENABLED' 'SSH' 'LOCAL' 'REMOTE'
  for NAME in "${_CFG_NAMES[@]}"; do
    if [[ "${_CFG[${NAME}.enabled]}" == 'false' ]]; then EN=no; else EN=yes; fi
    printf '%-*s  %-7s  %-27s  %-15s  %s\n' \
      "$_NAME_WIDTH" "$NAME" "$EN" \
      "$(_truncate "$(_ssh_label "$NAME")" 26)" \
      "${_CFG[${NAME}.bind_address]}:${_CFG[${NAME}.local_port]}" \
      "${_CFG[${NAME}.remote_host]}:${_CFG[${NAME}.remote_port]}"
  done
  return 0
}
#}}}

_cmd_config() { #{{{
  local OPT TARGET F INIT='' FORCE=''
  for OPT in "${_SUBCMD_OPTS[@]}"; do
    case "$OPT" in
      --init)  INIT=yes ;;
      --force) FORCE=yes ;;
      *)       _usage "unknown option for 'config': ${OPT}" ;;
    esac
  done
  if [[ -n "$INIT" ]]; then
    if [[ -n "$_OPT_CONFIG" ]]; then
      TARGET=$(_expand_tilde "$_OPT_CONFIG")
    else
      TARGET=$(_config_user_path)
    fi
    _config_init "$TARGET" "$FORCE"
    return 0
  fi
  _config_find
  _config_file_list
  for F in "${_CONFIG_FILES[@]}"; do
    printf '%s\n' "$F"
  done
  return 0
}
#}}}

_cmd_version() { #{{{
  printf '%s %s\n' "$__SCRIPT_NAME" "$_VERSION"
}
#}}}

_cmd_help() { #{{{
  local SUB=$1 FUNC
  if [[ -z "$SUB" ]]; then
    _show_usage
    return 0
  fi
  FUNC="_help_${SUB//-/_}"
  if declare -F "$FUNC" >/dev/null 2>&1; then
    "$FUNC"
  else
    _usage "no such subcommand: ${SUB}"
  fi
}
#}}}
#}}}

#-------------------------------------------------------------------------------
#- argument parsing ------------------------------------------------------------
#{{{
# template.sh の __LONG_OPT_NAMES 方式は --config <PATH> のような値付きオプションを
# 扱えないため、統合パーサをここに実装する (DESIGN 5.9)。
_parse_args() { #{{{
  while (( $# > 0 )); do
    case "$1" in
      -c|--config)
        [[ $# -lt 2 ]] && _usage "option requires an argument: $1"
        _OPT_CONFIG=$2; shift 2 ;;
      --config=*)   _OPT_CONFIG=${1#*=}; shift ;;
      -v|--verbose) _VERBOSE=$(( _VERBOSE + 1 )); shift ;;
      -vv)          _VERBOSE=2; shift ;;
      -q|--quiet)   _QUIET=yes; shift ;;
      --no-color)   _NO_COLOR=yes; shift ;;
      -h|--help)    _OPT_HELP=yes; shift ;;
      -V|--version) _OPT_VERSION=yes; shift ;;
      --)           shift
                    while (( $# > 0 )); do _ARGS+=("$1"); shift; done
                    break ;;
      # サブコマンド固有オプションは各 _cmd_* が解析する
      --init|--force|--user|--system|--now|--exit-code|-f)
                    _SUBCMD_OPTS+=("$1"); shift ;;
      --run-as)
        [[ $# -lt 2 ]] && _usage "option requires an argument: $1"
        _SUBCMD_OPTS+=("$1" "$2"); shift 2 ;;
      --run-as=*)   _SUBCMD_OPTS+=("$1"); shift ;;
      -*)           _usage "unknown option: $1" ;;
      *)
        if [[ -z "$_SUBCMD" ]]; then
          _SUBCMD=$1
          _SUBCMD_GIVEN=yes
        else
          _ARGS+=("$1")
        fi
        shift ;;
    esac
  done
  # SPECS 3.1: 引数なしは status
  [[ -z "$_SUBCMD" ]] && _SUBCMD=status
  return 0
}
#}}}

# 依存コマンドの存在確認 (DESIGN 7.2)
_check_prerequisites() { #{{{
  local CMD
  for CMD in ssh yq; do
    command -v "$CMD" >/dev/null 2>&1 || _error_exit "$_EXIT_DEPS" "$(_err_no_command "$CMD")"
  done
  return 0
}
#}}}
