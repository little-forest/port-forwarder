#- config functions ------------------------------------------------------------
#{{{
# 既知キー (未知キーは警告のみ / SPECS 4.4)
_KNOWN_ENTRY_KEYS=(description host user port identity local_port remote_host \
                   remote_port bind_address enabled check_mode check_interval ssh_options)
_KNOWN_GLOBAL_KEYS=(check_interval connect_timeout retry_initial retry_max retry_limit \
                    server_alive_interval server_alive_count_max log_file)
# yq の標準エラー出力を受けるファイル (遅延生成)
_YQ_ERR_FILE=
# 検証結果の警告表示を抑止する (test サブコマンドが自前で表示するため)
_NO_CFG_WARN=

# ユーザー設定ファイルの既定パス (SPECS 4.1)
_config_user_path() { #{{{
  if [[ -n "$XDG_CONFIG_HOME" ]]; then
    printf '%s\n' "${XDG_CONFIG_HOME}/port-forwarder/config.yaml"
  else
    printf '%s\n' "${HOME}/.config/port-forwarder/config.yaml"
  fi
}
#}}}

# 使用する設定ファイルを決定する (SPECS 4.1)
_config_find() { #{{{
  local P
  if [[ -n "$_OPT_CONFIG" ]]; then
    P=$(_expand_tilde "$_OPT_CONFIG")
    [[ -f "$P" ]] || _error_exit "$_EXIT_CONFIG" "$(_err_no_config "$P")"
    _CONFIG_FILE=$P
    return 0
  fi
  local CANDIDATES=()
  CANDIDATES+=("$(_config_user_path)")
  CANDIDATES+=('/etc/port-forwarder/config.yaml')
  for P in "${CANDIDATES[@]}"; do
    if [[ -f "$P" ]]; then
      _CONFIG_FILE=$P
      return 0
    fi
  done
  _error_exit "$_EXIT_CONFIG" "$(_err_no_config "${CANDIDATES[0]}")"
}
#}}}

# メイン設定 + conf.d/*.yaml|yml を名前順に並べる (SPECS 4.1)
_config_file_list() { #{{{
  local DIR CONFD F
  _CONFIG_FILES=("$_CONFIG_FILE")
  DIR=$(dirname "$_CONFIG_FILE")
  CONFD="${DIR}/conf.d"
  [[ -d "$CONFD" ]] || return 0
  local LIST=() SORTED=()
  shopt -s nullglob
  LIST=("$CONFD"/*.yaml "$CONFD"/*.yml)
  shopt -u nullglob
  (( ${#LIST[@]} == 0 )) && return 0
  mapfile -t SORTED < <(printf '%s\n' "${LIST[@]}" | LC_ALL=C sort)
  for F in "${SORTED[@]}"; do
    [[ -f "$F" ]] && _CONFIG_FILES+=("$F")
  done
  return 0
}
#}}}

# エントリの既存キーをすべて削除する (エントリ単位の置換 / DESIGN 4.1)
_config_purge_entry() { #{{{
  local NAME=$1 K
  for K in "${!_CFG[@]}"; do
    [[ "$K" == "${NAME}."* ]] && unset "_CFG[$K]"
  done
  unset "_CFG_OPTS[$NAME]"
  unset "_CFG_INVALID[$NAME]"
  return 0
}
#}}}

# エントリを無効化する (該当エントリのみ無効 / SPECS 4.4)
_config_invalidate() { #{{{
  local NAME=$1
  shift
  _CFG_INVALID[$NAME]=$*
  return 0
}
#}}}

_is_port() { #{{{
  local V=$1
  [[ "$V" =~ ^[0-9]+$ ]] || return 1
  (( V >= 1 && V <= 65535 )) || return 1
  return 0
}
#}}}

# ls -ln の 1 列目からパーミッションを 8 進数で得る (stat の OS 差異を避ける)
_file_mode_octal() { #{{{
  local F=$1 LINE M I DIGIT RES=
  # stat のオプション差異 (GNU / BSD) を避けるため ls -ln をパースする (DESIGN 4.3)
  # shellcheck disable=SC2012
  LINE=$(ls -ln "$F" 2>/dev/null | head -1)
  [[ -z "$LINE" ]] && return 1
  M=${LINE%% *}
  M=${M:1:9}
  (( ${#M} < 9 )) && return 1
  for I in 0 3 6; do
    DIGIT=0
    [[ "${M:$I:1}" == 'r' ]] && DIGIT=$(( DIGIT + 4 ))
    [[ "${M:$(( I + 1 )):1}" == 'w' ]] && DIGIT=$(( DIGIT + 2 ))
    [[ "${M:$(( I + 2 )):1}" =~ ^[xsSt]$ ]] && DIGIT=$(( DIGIT + 1 ))
    RES="${RES}${DIGIT}"
  done
  printf '0%s\n' "$RES"
  return 0
}
#}}}

# 設定ファイル 1 つを読み込む (DESIGN 4.1 の yq クエリ 0〜4)
_config_parse_file() { #{{{
  local FILE=$1
  local TAG NAME KEY VAL OPT LINE TABS RC

  # shellcheck disable=SC2119
  [[ -z "$_YQ_ERR_FILE" ]] && _YQ_ERR_FILE=$(__make_tmp)

  # 0. 構造検証
  TAG=$(yq -r '.entries | tag' "$FILE" 2>"$_YQ_ERR_FILE")
  RC=$?
  if (( RC != 0 )); then
    _error_exit "$_EXIT_CONFIG" "$(_err_parse_failed "$FILE" "$(_sanitize "$(cat "$_YQ_ERR_FILE")")")"
  fi
  if [[ "$TAG" != '!!map' && "$TAG" != '!!null' ]]; then
    _error_exit "$_EXIT_CONFIG" "$(_err_parse_failed "$FILE" "'entries' must be a map (got ${TAG})")"
  fi

  # 1. エントリ名 (記述順) と値の型
  while IFS=$'\t' read -r NAME TAG; do
    [[ -z "$NAME" ]] && continue
    if [[ -n "${_CFG_SOURCE[$NAME]}" ]]; then
      _config_purge_entry "$NAME"
    else
      _CFG_NAMES+=("$NAME")
    fi
    _CFG_SOURCE[$NAME]=$FILE
    if [[ "$TAG" != '!!map' ]]; then
      _config_invalidate "$NAME" "entry must be a map (got ${TAG})"
    fi
  done < <(yq -r '.entries // {} | to_entries[] | [.key, (.value | tag)] | @tsv' "$FILE" 2>/dev/null)

  # 2. global (キー単位の後勝ち)
  while IFS=$'\t' read -r KEY VAL; do
    [[ -z "$KEY" ]] && continue
    [[ "$VAL" == 'null' ]] && VAL=
    _GLOBAL[$KEY]=$VAL
  done < <(yq -r '.global // {} | to_entries[] | [.key, .value] | @tsv' "$FILE" 2>/dev/null)

  # 3. エントリのスカラー値 ($n は yq のクエリ内変数のためシングルクォートのままとする)
  # shellcheck disable=SC2016
  while IFS= read -r LINE; do
    [[ -z "$LINE" ]] && continue
    TABS=${LINE//[^$'\t']/}
    IFS=$'\t' read -r NAME KEY VAL <<<"$LINE"
    if (( ${#TABS} != 2 )); then
      # 値にタブが含まれ列がずれた場合は当該エントリを無効化する
      _config_invalidate "$NAME" "value of '${KEY}' contains a tab character"
      continue
    fi
    [[ -z "$NAME" || -z "$KEY" ]] && continue
    [[ "$VAL" == 'null' ]] && VAL=
    _CFG[${NAME}.${KEY}]=$VAL
  done < <(yq -r '.entries // {} | to_entries[]
                 | select((.value | tag) == "!!map")
                 | .key as $n | .value | to_entries[]
                 | select((.value | tag) != "!!seq" and (.value | tag) != "!!map")
                 | [$n, .key, .value] | @tsv' "$FILE" 2>/dev/null)

  # 4. ssh_options (配列。$n は yq のクエリ内変数)
  # shellcheck disable=SC2016
  while IFS=$'\t' read -r NAME OPT; do
    [[ -z "$NAME" ]] && continue
    if [[ "$OPT" == *"$_US"* ]]; then
      _config_invalidate "$NAME" "ssh_options must not contain a 0x1f character"
      continue
    fi
    if [[ -n "${_CFG_OPTS[$NAME]}" ]]; then
      _CFG_OPTS[$NAME]="${_CFG_OPTS[$NAME]}${_US}${OPT}"
    else
      _CFG_OPTS[$NAME]=$OPT
    fi
  done < <(yq -r '.entries // {} | to_entries[]
                 | select((.value | tag) == "!!map")
                 | select((.value.ssh_options // [] | tag) == "!!seq")
                 | .key as $n | (.value.ssh_options // []) | .[] | [$n, .] | @tsv' "$FILE" 2>/dev/null)

  return 0
}
#}}}

# 既定値を埋める (SPECS 4.3 / DESIGN 4.2)
_config_apply_defaults() { #{{{
  local NAME KEY V
  local -A GDEF=(
    [check_interval]=30
    [connect_timeout]=10
    [retry_initial]=5
    [retry_max]=300
    [retry_limit]=0
    [server_alive_interval]=15
    [server_alive_count_max]=3
  )
  for KEY in "${!GDEF[@]}"; do
    [[ -z "${_GLOBAL[$KEY]}" ]] && _GLOBAL[$KEY]=${GDEF[$KEY]}
  done
  [[ -z "${_GLOBAL[log_file]}" ]] && _GLOBAL[log_file]=

  if [[ "${_GLOBAL[check_interval]}" =~ ^[0-9]+$ ]] && (( _GLOBAL[check_interval] < _MIN_CHECK_INTERVAL )); then
    __show_warn "global.check_interval ${_GLOBAL[check_interval]} is below the minimum ${_MIN_CHECK_INTERVAL}; using ${_MIN_CHECK_INTERVAL}"
    _GLOBAL[check_interval]=$_MIN_CHECK_INTERVAL
  fi

  for NAME in "${_CFG_NAMES[@]}"; do
    [[ -z "${_CFG[${NAME}.user]}" ]]           && _CFG[${NAME}.user]=${USER:-}
    [[ -z "${_CFG[${NAME}.port]}" ]]           && _CFG[${NAME}.port]=22
    [[ -z "${_CFG[${NAME}.remote_host]}" ]]    && _CFG[${NAME}.remote_host]=localhost
    [[ -z "${_CFG[${NAME}.bind_address]}" ]]   && _CFG[${NAME}.bind_address]=127.0.0.1
    [[ -z "${_CFG[${NAME}.enabled]}" ]]        && _CFG[${NAME}.enabled]=true
    [[ -z "${_CFG[${NAME}.check_mode]}" ]]     && _CFG[${NAME}.check_mode]=remote
    if [[ -z "${_CFG[${NAME}.check_interval]}" ]]; then
      _CFG[${NAME}.check_interval]=${_GLOBAL[check_interval]}
    elif [[ "${_CFG[${NAME}.check_interval]}" =~ ^[0-9]+$ ]] && (( _CFG[${NAME}.check_interval] < _MIN_CHECK_INTERVAL )); then
      __show_warn "[${NAME}] check_interval ${_CFG[${NAME}.check_interval]} is below the minimum ${_MIN_CHECK_INTERVAL}; using ${_MIN_CHECK_INTERVAL}"
      _CFG[${NAME}.check_interval]=$_MIN_CHECK_INTERVAL
    fi
    V=${_CFG[${NAME}.identity]}
    [[ -n "$V" ]] && _CFG[${NAME}.identity]=$(_expand_tilde "$V")
  done
  return 0
}
#}}}

# 真偽値表記を true / false に正規化する
_normalize_bool() { #{{{
  local V=$1
  case "${V,,}" in
    true|yes|1|on)   printf 'true\n';  return 0 ;;
    false|no|0|off)  printf 'false\n'; return 0 ;;
  esac
  printf '%s\n' "$V"
  return 1
}
#}}}

# 設定の検証 (SPECS 4.4 / DESIGN 4.3)
_config_validate() { #{{{
  local NAME KEY V SUF OTHER PKEY MODE
  local -A SEEN_PORT=()

  for NAME in "${_CFG_NAMES[@]}"; do
    [[ -n "${_CFG_INVALID[$NAME]}" ]] && continue

    if [[ ! "$NAME" =~ ^[A-Za-z0-9._-]{1,32}$ ]]; then
      _config_invalidate "$NAME" "invalid entry name (must match [A-Za-z0-9._-]{1,32})"
      continue
    fi

    # 必須キー
    local BAD=
    for KEY in host local_port remote_port; do
      if [[ -z "${_CFG[${NAME}.${KEY}]}" ]]; then
        _config_invalidate "$NAME" "$(_err_missing_key "$NAME" "$KEY")"
        BAD=yes
        break
      fi
    done
    [[ -n "$BAD" ]] && continue

    # ポート範囲
    for KEY in local_port remote_port port; do
      V=${_CFG[${NAME}.${KEY}]}
      if ! _is_port "$V"; then
        _config_invalidate "$NAME" "$(_err_bad_port "$NAME" "$KEY" "$V")"
        BAD=yes
        break
      fi
    done
    [[ -n "$BAD" ]] && continue

    # local_port の重複 (重複したら両方を無効化する)
    PKEY="${_CFG[${NAME}.bind_address]}:${_CFG[${NAME}.local_port]}"
    if [[ -n "${SEEN_PORT[$PKEY]}" ]]; then
      OTHER=${SEEN_PORT[$PKEY]}
      V=$(_err_dup_port "${_CFG[${NAME}.local_port]}" "$OTHER" "$NAME")
      _config_invalidate "$NAME" "$V"
      _config_invalidate "$OTHER" "$V"
      continue
    fi
    SEEN_PORT[$PKEY]=$NAME

    # identity の存在と権限
    V=${_CFG[${NAME}.identity]}
    if [[ -n "$V" ]]; then
      if [[ ! -f "$V" ]]; then
        _config_invalidate "$NAME" "$(_err_no_identity "$NAME" "$V")"
        continue
      fi
      local MODE
      MODE=$(_file_mode_octal "$V")
      if [[ -n "$MODE" && "${MODE:2:2}" != '00' ]]; then
        _config_invalidate "$NAME" "$(_err_key_perm "$NAME" "$V" "$MODE")"
        continue
      fi
    fi

    # check_mode
    MODE=${_CFG[${NAME}.check_mode]}
    if [[ "$MODE" != 'process' && "$MODE" != 'tcp' && "$MODE" != 'remote' ]]; then
      _config_invalidate "$NAME" "[${NAME}] invalid check_mode '${MODE}' (must be process, tcp or remote)"
      continue
    fi

    # enabled の正規化
    if ! V=$(_normalize_bool "${_CFG[${NAME}.enabled]}"); then
      _config_invalidate "$NAME" "[${NAME}] invalid enabled value '${_CFG[${NAME}.enabled]}'"
      continue
    fi
    _CFG[${NAME}.enabled]=$V

    # check_interval
    V=${_CFG[${NAME}.check_interval]}
    if [[ ! "$V" =~ ^[0-9]+$ ]]; then
      _config_invalidate "$NAME" "[${NAME}] check_interval must be an integer (got '${V}')"
      continue
    fi

    # bind_address の安全性 (SPECS 11 章)
    V=${_CFG[${NAME}.bind_address]}
    if [[ "$V" == '0.0.0.0' || "$V" == '::' ]]; then
      __show_warn "[${NAME}] bind_address ${V} exposes local port ${_CFG[${NAME}.local_port]} to other hosts"
    fi

    # ssh_options で StrictHostKeyChecking を緩めた場合は警告する (DESIGN 9)
    if [[ "${_CFG_OPTS[$NAME]}" == *'StrictHostKeyChecking=no'* \
       || "${_CFG_OPTS[$NAME]}" == *'StrictHostKeyChecking=accept-new'* ]]; then
      __show_warn "[${NAME}] ssh_options relaxes StrictHostKeyChecking; host keys will not be verified"
    fi

    # 未知キー (警告のみ)
    for KEY in "${!_CFG[@]}"; do
      [[ "$KEY" == "${NAME}."* ]] || continue
      SUF=${KEY#"${NAME}".}
      [[ "$SUF" == *.* ]] && continue
      _in_array "$SUF" "${_KNOWN_ENTRY_KEYS[@]}" && continue
      __show_warn "[${NAME}] unknown key '${SUF}' (ignored)"
    done
  done

  # 未知の global キー (警告のみ)
  for KEY in "${!_GLOBAL[@]}"; do
    _in_array "$KEY" "${_KNOWN_GLOBAL_KEYS[@]}" && continue
    __show_warn "unknown key 'global.${KEY}' (ignored)"
  done

  # 無効エントリの警告 (ポート重複のように 2 エントリで同一のものは 1 回だけ出す)
  if [[ -z "$_NO_CFG_WARN" ]]; then
    local -A SEEN_MSG=()
    for NAME in "${_CFG_NAMES[@]}"; do
      V=${_CFG_INVALID[$NAME]}
      [[ -z "$V" || -n "${SEEN_MSG[$V]}" ]] && continue
      SEEN_MSG[$V]=1
      __show_warn "$V"
    done
  fi
  return 0
}
#}}}

# 設定ファイルが他ユーザーから書き込み可能なら警告する (SPECS 11 章)
_config_check_perms() { #{{{
  local F MODE
  for F in "${_CONFIG_FILES[@]}"; do
    MODE=$(_file_mode_octal "$F") || continue
    if [[ "${MODE:2:1}" == [2367] || "${MODE:3:1}" == [2367] ]]; then
      __show_warn "config file ${F} is writable by other users (${MODE})"
    fi
  done
  return 0
}
#}}}

# 読み込み済みの設定を破棄する (reload 用)
_config_reset() { #{{{
  _CFG=()
  _CFG_OPTS=()
  _GLOBAL=()
  _CFG_INVALID=()
  _CFG_SOURCE=()
  _CFG_NAMES=()
  _CONFIG_FILES=()
  return 0
}
#}}}

# 設定の探索・読み込み・検証をまとめて行う
_config_setup() { #{{{
  _config_find
  _config_file_list
  local F
  for F in "${_CONFIG_FILES[@]}"; do
    _debug "loading config: ${F}"
    _config_parse_file "$F"
  done
  if (( ${#_CFG_NAMES[@]} == 0 )); then
    _error_exit "$_EXIT_CONFIG" "$(_err_no_entries "$_CONFIG_FILE")"
  fi
  _config_apply_defaults
  _config_validate
  _config_check_perms
  return 0
}
#}}}

# 設定ファイルの雛形を生成する (SPECS 4.5)
_config_init() { #{{{
  local PATH_=$1 FORCE=$2 DIR
  if [[ -e "$PATH_" && -z "$FORCE" ]]; then
    _error_exit "$_EXIT_ERROR" "config file already exists: ${PATH_}. Use --force to overwrite it."
  fi
  DIR=$(dirname "$PATH_")
  if [[ ! -d "$DIR" ]] && ! mkdir -p "$DIR" 2>/dev/null; then
    _error_exit "$_EXIT_ERROR" "cannot create directory: ${DIR}"
  fi
  cat > "$PATH_" <<'PFWD_CONFIG_TEMPLATE'
# port-forwarder configuration
#
# See 'pfwd help config' and SPECS.md for the full reference.

# グローバル設定 (省略可。省略時は既定値)
global:
  check_interval: 30          # 死活監視間隔(秒)。最小 5
  connect_timeout: 10         # SSH 接続タイムアウト(秒)
  retry_initial: 5            # 再接続の初回待ち時間(秒)
  retry_max: 300              # 再接続待ち時間の上限(秒)
  retry_limit: 0              # 連続失敗の上限回数。0 は無制限
  server_alive_interval: 15   # SSH keepalive 間隔(秒)
  server_alive_count_max: 3   # keepalive 応答なし許容回数
  # log_file: ~/.local/state/port-forwarder/port-forwarder.log  # 未指定なら標準出力

# エントリ定義。キーがエントリ名 ([A-Za-z0-9._-]{1,32}) で一意
entries:
  example:
    description: example tunnel     # 任意: 一覧表示に出る説明
    host: bastion.example.com       # 必須: SSH 接続先ホスト
    # user: your-name               # 任意: 既定は $USER
    # port: 22                      # 任意: SSH ポート。既定 22
    # identity: ~/.ssh/id_ed25519   # 任意: 秘密鍵
    local_port: 18080               # 必須: ローカル待ち受けポート
    remote_host: localhost          # 任意: 踏み台から見た転送先。既定 localhost
    remote_port: 80                 # 必須: 転送先ポート
    # bind_address: 127.0.0.1       # 任意: 既定 127.0.0.1
    enabled: false                  # 任意: 既定 true
    check_mode: remote              # 任意: process | tcp | remote。既定 remote
    # ssh_options:                  # 任意: 追加の ssh -o 指定
    #   - Compression=yes
PFWD_CONFIG_TEMPLATE
  chmod 600 "$PATH_" 2>/dev/null
  printf 'Created: %s\n' "$PATH_"
  printf "Edit the file and run '%s test' to validate.\n" "$__SCRIPT_NAME"
  return 0
}
#}}}
#}}}

#-------------------------------------------------------------------------------
#- state functions -------------------------------------------------------------
#{{{
# state ファイルに書き出すキー (DESIGN 4.4)
_STATE_KEYS=(status pid ctl since connected_since retry_count backoff \
             next_retry_at next_check_at conn_sig last_error)

# 実行時ディレクトリを決定する (DESIGN 3.3)
_setup_runtime_dir() { #{{{
  if (( EUID == 0 )) && [[ "$_CONFIG_FILE" == '/etc/port-forwarder/'* ]]; then
    if [[ "$(uname)" == 'Darwin' ]]; then
      _RUN_DIR='/usr/local/var/run/port-forwarder'
    else
      _RUN_DIR='/run/port-forwarder'
    fi
  elif [[ -n "$XDG_RUNTIME_DIR" ]]; then
    _RUN_DIR="${XDG_RUNTIME_DIR}/port-forwarder"
  else
    _RUN_DIR="${HOME}/.local/state/port-forwarder/run"
  fi
  _state_init
}
#}}}

# 実行時ディレクトリを作成する (パーミッションは umask 077 に従う)
_state_init() { #{{{
  local D
  for D in "$_RUN_DIR" "${_RUN_DIR}/state" "${_RUN_DIR}/ctl" "${_RUN_DIR}/err"; do
    [[ -d "$D" ]] && continue
    mkdir -p "$D" 2>/dev/null || _error_exit "$_EXIT_ERROR" "cannot create runtime directory: ${D}"
  done
  chmod 700 "$_RUN_DIR" 2>/dev/null
  return 0
}
#}}}

# state ファイルを読み込む。無ければ既定値で初期化する
_state_load() { #{{{
  local NAME=$1 F K V
  F="${_RUN_DIR}/state/${NAME}.state"
  _ST[${NAME}.status]=stopped
  _ST[${NAME}.pid]=0
  _ST[${NAME}.ctl]=
  _ST[${NAME}.since]=0
  _ST[${NAME}.connected_since]=0
  _ST[${NAME}.retry_count]=0
  _ST[${NAME}.backoff]=0
  _ST[${NAME}.next_retry_at]=0
  _ST[${NAME}.next_check_at]=0
  _ST[${NAME}.conn_sig]=
  _ST[${NAME}.last_error]=
  [[ -f "$F" ]] || return 1
  # state ファイルは source せず自前でパースする (DESIGN 9)
  while IFS='=' read -r K V; do
    [[ -z "$K" ]] && continue
    _in_array "$K" "${_STATE_KEYS[@]}" || continue
    _ST[${NAME}.${K}]=$V
  done < "$F"
  return 0
}
#}}}

_state_load_all() { #{{{
  local NAME
  for NAME in "${_CFG_NAMES[@]}"; do
    _state_load "$NAME"
  done
  return 0
}
#}}}

# _ST の内容を state ファイルへアトミックに書き出す (デーモンのみが呼ぶ)
_state_flush() { #{{{
  local NAME=$1 F TMP K
  F="${_RUN_DIR}/state/${NAME}.state"
  TMP="${_RUN_DIR}/err/${NAME}.state.tmp"
  {
    for K in "${_STATE_KEYS[@]}"; do
      printf '%s=%s\n' "$K" "${_ST[${NAME}.${K}]}"
    done
  } > "$TMP" 2>/dev/null || return 1
  mv -f "$TMP" "$F" 2>/dev/null || return 1
  unset "_ST_DIRTY[$NAME]"
  return 0
}
#}}}

# 変更のあったエントリだけを書き出す
_state_flush_dirty() { #{{{
  local NAME
  for NAME in "${!_ST_DIRTY[@]}"; do
    _state_flush "$NAME"
  done
  return 0
}
#}}}

_state_set() { #{{{
  local NAME=$1 KEY=$2 VAL=$3
  _ST[${NAME}.${KEY}]=$VAL
  _ST_DIRTY[$NAME]=1
  return 0
}
#}}}

_state_get() { #{{{
  printf '%s\n' "${_ST[${1}.${2}]}"
}
#}}}

# 状態遷移はすべてこの関数を通す (ログの一貫性のため / DESIGN 5.4)
_state_transit() { #{{{
  local NAME=$1 NEW=$2 REASON=$3 OLD
  OLD=${_ST[${NAME}.status]}
  _ST[${NAME}.status]=$NEW
  _ST[${NAME}.since]=$(_now)
  _ST_DIRTY[$NAME]=1
  [[ "$OLD" == "$NEW" ]] && return 0
  if [[ -n "$REASON" ]]; then
    _log_info "$NAME" "state: ${OLD} -> ${NEW} (${REASON})"
  else
    _log_info "$NAME" "state: ${OLD} -> ${NEW}"
  fi
  return 0
}
#}}}

# エントリ削除時に state / desired / err を削除する
_state_remove() { #{{{
  local NAME=$1 K
  rm -f "${_RUN_DIR}/state/${NAME}.state" \
        "${_RUN_DIR}/state/${NAME}.desired" \
        "${_RUN_DIR}/err/${NAME}.err" 2>/dev/null
  for K in "${!_ST[@]}"; do
    [[ "$K" == "${NAME}."* ]] && unset "_ST[$K]"
  done
  unset "_ST_DIRTY[$NAME]"
  return 0
}
#}}}

# 希望状態を書く (書き手は CLI のみ / DESIGN 4.5)
_desired_set() { #{{{
  local NAME=$1 VAL=$2 F TMP
  F="${_RUN_DIR}/state/${NAME}.desired"
  TMP="${_RUN_DIR}/err/${NAME}.desired.tmp"
  printf '%s\n' "$VAL" > "$TMP" 2>/dev/null || return 1
  mv -f "$TMP" "$F" 2>/dev/null || return 1
  return 0
}
#}}}

# 希望状態を読む。ファイルが無ければ enabled を初期値とする
_desired_get() { #{{{
  local NAME=$1 F V
  F="${_RUN_DIR}/state/${NAME}.desired"
  if [[ -f "$F" ]]; then
    read -r V < "$F"
    case "$V" in
      up|down) printf '%s\n' "$V"; return 0 ;;
    esac
  fi
  if [[ "${_CFG[${NAME}.enabled]}" == 'false' ]]; then
    printf 'down\n'
  else
    printf 'up\n'
  fi
  return 0
}
#}}}

_desired_remove() { #{{{
  rm -f "${_RUN_DIR}/state/${1}.desired" 2>/dev/null
  return 0
}
#}}}
#}}}

#-------------------------------------------------------------------------------
#- ssh session functions -------------------------------------------------------
#{{{
# ControlPath を決定する (DESIGN 3.3)
_ctl_path() { #{{{
  local NAME=$1 P BASE SUM
  P="${_RUN_DIR}/ctl/${NAME}.sock"
  if (( ${#P} > _CTL_PATH_MAX )); then
    # UNIX ドメインソケットのパス長上限 (macOS 104 / Linux 108) を超えるため
    # TMPDIR 配下の短いパスに退避する
    BASE="${TMPDIR:-/tmp}/pfwd-${EUID}"
    mkdir -p "$BASE" 2>/dev/null
    chmod 700 "$BASE" 2>/dev/null
    SUM=$(printf '%s' "$NAME" | cksum | awk '{print $1}')
    P="${BASE}/${SUM}.sock"
  fi
  (( ${#P} > _CTL_PATH_MAX )) && return 1
  printf '%s\n' "$P"
  return 0
}
#}}}

# 接続パラメータの署名 (DESIGN 4.6)
_conn_sig() { #{{{
  local NAME=$1
  printf '%s\n' "${_CFG[${NAME}.host]}${_US}${_CFG[${NAME}.user]}${_US}${_CFG[${NAME}.port]}${_US}${_CFG[${NAME}.identity]}${_US}${_CFG[${NAME}.local_port]}${_US}${_CFG[${NAME}.remote_host]}${_US}${_CFG[${NAME}.remote_port]}${_US}${_CFG[${NAME}.bind_address]}${_US}${_CFG_OPTS[$NAME]}"
}
#}}}

# エントリの ssh_options を配列に展開する
_entry_ssh_options() { #{{{
  local NAME=$1
  _ENTRY_OPTS=()
  [[ -z "${_CFG_OPTS[$NAME]}" ]] && return 0
  IFS=$_US read -r -a _ENTRY_OPTS <<<"${_CFG_OPTS[$NAME]}"
  return 0
}
#}}}

# ssh の起動引数を _SSH_ARGS に組み立てる (DESIGN 5.5)
_ssh_build_args() { #{{{
  local NAME=$1 CTL=$2 OPT
  _entry_ssh_options "$NAME"
  _SSH_ARGS=(ssh -N -T -M -S "$CTL"
    -o ControlMaster=yes
    -o ControlPersist=no
    -o ExitOnForwardFailure=yes
    -o BatchMode=yes
    -o NumberOfPasswordPrompts=0
    -o StrictHostKeyChecking=yes
    -o ConnectTimeout="${_GLOBAL[connect_timeout]}"
    -o ServerAliveInterval="${_GLOBAL[server_alive_interval]}"
    -o ServerAliveCountMax="${_GLOBAL[server_alive_count_max]}"
    -p "${_CFG[${NAME}.port]}"
    -L "${_CFG[${NAME}.bind_address]}:${_CFG[${NAME}.local_port]}:${_CFG[${NAME}.remote_host]}:${_CFG[${NAME}.remote_port]}")
  [[ -n "${_CFG[${NAME}.identity]}" ]] && _SSH_ARGS+=(-o IdentitiesOnly=yes -i "${_CFG[${NAME}.identity]}")
  [[ -n "${_CFG[${NAME}.user]}" ]] && _SSH_ARGS+=(-l "${_CFG[${NAME}.user]}")
  # ユーザー指定の ssh_options は既定の後に置き、後勝ちで上書き可能とする
  for OPT in "${_ENTRY_OPTS[@]}"; do
    _SSH_ARGS+=(-o "$OPT")
  done
  _SSH_ARGS+=("${_CFG[${NAME}.host]}")
  return 0
}
#}}}

# ssh をバックグラウンド起動する。確立の完了は待たない (DESIGN 5.5)
_ssh_start() { #{{{
  local NAME=$1 CTL ERRF PID
  if ! CTL=$(_ctl_path "$NAME"); then
    _state_set "$NAME" last_error "ControlPath for '${NAME}' exceeds the socket path limit"
    _log_error "$NAME" "ControlPath exceeds the socket path limit; cannot start"
    _state_transit "$NAME" failed 'ControlPath too long'
    return 1
  fi
  rm -f "$CTL" 2>/dev/null
  ERRF="${_RUN_DIR}/err/${NAME}.err"
  : > "$ERRF" 2>/dev/null
  _ssh_build_args "$NAME" "$CTL"
  _debug2 "[${NAME}] exec: ${_SSH_ARGS[*]}"
  "${_SSH_ARGS[@]}" </dev/null >>"$ERRF" 2>&1 &
  PID=$!
  _state_set "$NAME" pid "$PID"
  _state_set "$NAME" ctl "$CTL"
  _state_set "$NAME" conn_sig "$(_conn_sig "$NAME")"
  _state_set "$NAME" last_error ''
  _state_transit "$NAME" connecting
  _log_info "$NAME" "starting ssh (pid=${PID}, ${_CFG[${NAME}.bind_address]}:${_CFG[${NAME}.local_port]} -> ${_CFG[${NAME}.remote_host]}:${_CFG[${NAME}.remote_port]})"
  return 0
}
#}}}

# セッションが生きているか (ControlMaster を優先し、PID にフォールバックする)
_ssh_is_alive() { #{{{
  local NAME=$1 CTL PID
  CTL=${_ST[${NAME}.ctl]}
  PID=${_ST[${NAME}.pid]}
  if [[ -n "$CTL" && -S "$CTL" ]]; then
    ssh -O check -S "$CTL" -o BatchMode=yes "${_CFG[${NAME}.host]}" >/dev/null 2>&1
    return $?
  fi
  [[ -n "$PID" && "$PID" != '0' ]] || return 1
  kill -0 "$PID" 2>/dev/null
}
#}}}

# セッションを確実に終了させる (DESIGN 5.5)
_ssh_stop() { #{{{
  local NAME=$1 CTL PID I
  CTL=${_ST[${NAME}.ctl]}
  PID=${_ST[${NAME}.pid]}

  # 1. ControlMaster 経由の終了
  if [[ -n "$CTL" && -S "$CTL" ]]; then
    ssh -O exit -S "$CTL" -o BatchMode=yes "${_CFG[${NAME}.host]}" >/dev/null 2>&1
    for (( I = 0; I < 20; I++ )); do
      _ssh_pid_alive "$PID" || break
      sleep 0.1
    done
  fi

  # 2. SIGTERM
  if _ssh_pid_alive "$PID"; then
    kill -TERM "$PID" 2>/dev/null
    for (( I = 0; I < 30; I++ )); do
      _ssh_pid_alive "$PID" || break
      sleep 0.1
    done
  fi

  # 3. SIGKILL
  if _ssh_pid_alive "$PID"; then
    _log_warn "$NAME" "ssh (pid=${PID}) did not exit; sending SIGKILL"
    kill -KILL "$PID" 2>/dev/null
    sleep 0.1
  fi

  # 4. ソケットの後始末
  [[ -n "$CTL" ]] && rm -f "$CTL" 2>/dev/null

  # 5. PID を落とす
  _state_set "$NAME" pid 0
  return 0
}
#}}}

_ssh_pid_alive() { #{{{
  local PID=$1
  [[ -n "$PID" && "$PID" != '0' ]] || return 1
  kill -0 "$PID" 2>/dev/null
}
#}}}

# ssh の標準エラー出力から直近の意味のある 1 行を取り出し、ファイルを切り詰める
_ssh_take_error() { #{{{
  local NAME=$1 F LINE MSG=
  F="${_RUN_DIR}/err/${NAME}.err"
  if [[ -f "$F" ]]; then
    while IFS= read -r LINE; do
      [[ -z "$LINE" ]] && continue
      [[ "$LINE" == 'Warning: Permanently added'* ]] && continue
      MSG=$LINE
    done < "$F"
    : > "$F" 2>/dev/null
  fi
  _sanitize "$MSG"
  return 0
}
#}}}

# ssh の失敗理由を分類する (DESIGN 7.4)。fatal はリトライしても成功しえないもの
_ssh_classify_error() { #{{{
  local MSG=$1
  case "$MSG" in
    *'Host key verification failed'*|*'host key is not known'*|*'HOST IDENTIFICATION HAS CHANGED'*)
      printf 'fatal\n' ;;
    *'Permission denied (publickey'*|*'Permission denied ('*)
      printf 'fatal\n' ;;
    *passphrase*|*Passphrase*)
      printf 'fatal\n' ;;
    *'Address already in use'*|*'cannot listen to port'*|*'bind: '*)
      printf 'fatal\n' ;;
    *)
      printf 'retry\n' ;;
  esac
}
#}}}

# 失敗理由に応じた追加の案内 (SPECS 9.2 / 10 章)
_ssh_error_hint() { #{{{
  local NAME=$1 MSG=$2
  case "$MSG" in
    *passphrase*|*Passphrase*)
      printf 'passphrase-protected key requires ssh-agent\n' ;;
    *'Host key verification failed'*|*'host key is not known'*)
      _err_unknown_host_key "$NAME" "${_CFG[${NAME}.host]}" ;;
    *'Address already in use'*|*'cannot listen to port'*)
      _err_port_in_use "$NAME" "${_CFG[${NAME}.local_port]}" ;;
    *)
      printf '\n' ;;
  esac
}
#}}}
#}}}

#-------------------------------------------------------------------------------
#- health check functions ------------------------------------------------------
#{{{
# 利用可能な TCP プローブ手段を判定する (DESIGN 5.6)
_probe_detect() { #{{{
  local OUT
  OUT=$( { exec 3<>'/dev/tcp/127.0.0.1/1'; } 2>&1 )
  if [[ "$OUT" != *'No such file or directory'* ]]; then
    _PROBE_BACKEND=devtcp
  elif command -v nc >/dev/null 2>&1; then
    _PROBE_BACKEND=nc
    _log_warn - "bash /dev/tcp is not available; check_mode 'remote' is degraded to 'tcp'"
  else
    _PROBE_BACKEND=none
    _log_warn - "neither /dev/tcp nor nc is available; check_mode is degraded to 'process'"
  fi
  _debug "probe backend: ${_PROBE_BACKEND}"
  return 0
}
#}}}

# TCP 接続の可否のみを判定する (0=接続可 / 1=接続不可 / 2=判定不能)
_probe_tcp() { #{{{
  local ADDR=$1 PORT=$2
  [[ -z "$_PROBE_BACKEND" ]] && _probe_detect
  case "$_PROBE_BACKEND" in
    devtcp)
      # exec のリダイレクトエラーを握り潰すため、グループにまとめて 2> を掛ける
      # (exec に直接 2>/dev/null を付けるとシェルの stderr 自体が差し替わる)
      { exec 3<>"/dev/tcp/${ADDR}/${PORT}"; } 2>/dev/null || return 1
      exec 3<&- 3>&-
      return 0 ;;
    nc)
      nc -z -w "$_CHECK_TIMEOUT" "$ADDR" "$PORT" >/dev/null 2>&1 || return 1
      return 0 ;;
    *)
      return 2 ;;
  esac
}
#}}}

# 転送が成立しているかを判定する (0=成立 / 1=即切断 / 2=接続不可)
# ローカルフォワードは転送先へのチャネルを開けないと接続を即座に閉じる。
_probe_forward() { #{{{
  local ADDR=$1 PORT=$2 RC DUMMY
  { exec 3<>"/dev/tcp/${ADDR}/${PORT}"; } 2>/dev/null || return 2
  # 受信内容は使わない (到達判定のみ)
  # shellcheck disable=SC2034
  read -r -t "$_REMOTE_PROBE_WAIT" -N 1 -u 3 DUMMY
  RC=$?
  exec 3<&- 3>&-
  (( RC == 0 ))  && return 0    # データを受信した = 転送先まで到達している
  (( RC > 128 )) && return 0    # 待機タイムアウト = 接続が維持されている
  return 1                      # EOF = 転送先へ届かず即切断された
}
#}}}

# ローカルポートが空いているか (0=空き / 1=使用中)
_is_port_free() { #{{{
  local ADDR=$1 PORT=$2
  _probe_tcp "$ADDR" "$PORT"
  case $? in
    0) return 1 ;;   # 接続できた = 使用中
    1) return 0 ;;   # 接続できない = 空き
    *) return 0 ;;   # 判定不能な場合は空きとみなす
  esac
}
#}}}

# check_mode に応じた死活監視 (0=正常 / 1=異常)
_health_check() { #{{{
  local NAME=$1 MODE ADDR PORT RC
  MODE=${_CFG[${NAME}.check_mode]}
  ADDR=${_CFG[${NAME}.bind_address]}
  PORT=${_CFG[${NAME}.local_port]}
  [[ "$ADDR" == '0.0.0.0' || "$ADDR" == '::' ]] && ADDR=127.0.0.1
  [[ -z "$_PROBE_BACKEND" ]] && _probe_detect

  _ssh_is_alive "$NAME" || return 1
  case "$MODE" in
    process)
      return 0 ;;
    tcp)
      _probe_tcp "$ADDR" "$PORT"
      RC=$?
      (( RC == 0 )) && return 0
      (( RC == 2 )) && return 0   # 判定不能なら process 相当に劣化する
      return 1 ;;
    remote)
      if [[ "$_PROBE_BACKEND" == 'devtcp' ]]; then
        _probe_forward "$ADDR" "$PORT" && return 0
        return 1
      fi
      # /dev/tcp が使えない場合は tcp 相当に劣化する
      _probe_tcp "$ADDR" "$PORT"
      RC=$?
      (( RC == 0 )) && return 0
      (( RC == 2 )) && return 0
      return 1 ;;
  esac
  return 0
}
#}}}
#}}}

#-------------------------------------------------------------------------------
#- daemon functions ------------------------------------------------------------
#{{{
_DAEMON_RUNNING_PID=
_CHECKS_THIS_TICK=0
_RELOAD_COUNT=0

# 死活監視で使うプローブ先アドレス (待ち受けが 0.0.0.0 でも 127.0.0.1 を叩く)
_probe_addr() { #{{{
  local A=${_CFG[${1}.bind_address]}
  [[ "$A" == '0.0.0.0' || "$A" == '::' ]] && A=127.0.0.1
  printf '%s\n' "$A"
}
#}}}

# 起動中のデーモンの PID を返す (生きていなければ 1)
_daemon_pid() { #{{{
  local F="${_RUN_DIR}/daemon.pid" PID
  [[ -f "$F" ]] || return 1
  read -r PID < "$F" 2>/dev/null
  [[ "$PID" =~ ^[0-9]+$ ]] || return 1
  kill -0 "$PID" 2>/dev/null || return 1
  printf '%s\n' "$PID"
  return 0
}
#}}}

# mkdir の原子性でロックを取る (flock は macOS に無いため使わない / DESIGN 5.8)
_daemon_lock_acquire() { #{{{
  local LOCK="${_RUN_DIR}/daemon.lock" PID
  _DAEMON_RUNNING_PID=
  if mkdir "$LOCK" 2>/dev/null; then
    printf '%s\n' "$$" > "${LOCK}/pid"
    return 0
  fi
  PID=$(cat "${LOCK}/pid" 2>/dev/null)
  if [[ "$PID" =~ ^[0-9]+$ ]] && kill -0 "$PID" 2>/dev/null; then
    _DAEMON_RUNNING_PID=$PID
    return 1
  fi
  _log_warn - "removing stale lock (pid=${PID:-unknown})"
  rm -rf "$LOCK" 2>/dev/null
  if mkdir "$LOCK" 2>/dev/null; then
    printf '%s\n' "$$" > "${LOCK}/pid"
    return 0
  fi
  return 1
}
#}}}

_daemon_lock_release() { #{{{
  rm -rf "${_RUN_DIR}/daemon.lock" 2>/dev/null
  return 0
}
#}}}

# 採用した設定と起動時刻を記録する (reload 完了の通知も兼ねる)
_daemon_write_meta() { #{{{
  local F="${_RUN_DIR}/daemon.meta" TMP="${_RUN_DIR}/daemon.meta.tmp"
  {
    printf 'pid=%s\n' "$$"
    printf 'config=%s\n' "$_CONFIG_FILE"
    printf 'started=%s\n' "$_DAEMON_STARTED"
    printf 'updated=%s\n' "$(_now)"
    printf 'reloads=%s\n' "$_RELOAD_COUNT"
  } > "$TMP" 2>/dev/null || return 1
  mv -f "$TMP" "$F" 2>/dev/null
  return 0
}
#}}}

# シグナルハンドラはフラグを立てるだけにする (DESIGN 5.7)
_on_term() { _SHUTDOWN=1; }
_on_hup()  { _FLAG_HUP=1; }
_on_usr1() { _FLAG_USR1=1; }

# state を読み直し、監視時刻を分散させる (DESIGN 5.7)
_daemon_init_states() { #{{{
  local NAME NOW I=0 INTERVAL
  NOW=$(_now)
  for NAME in "${_CFG_NAMES[@]}"; do
    _state_load "$NAME"
    INTERVAL=${_CFG[${NAME}.check_interval]}
    [[ "$INTERVAL" =~ ^[0-9]+$ ]] || INTERVAL=$_MIN_CHECK_INTERVAL
    if [[ -n "${_CFG_INVALID[$NAME]}" ]]; then
      _state_set "$NAME" pid 0
      _state_set "$NAME" last_error "${_CFG_INVALID[$NAME]}"
      _state_transit "$NAME" failed 'invalid configuration'
    elif _ssh_is_alive "$NAME"; then
      # 前回のデーモンが残したセッションを引き継ぐ
      (( _ST[${NAME}.connected_since] == 0 )) && _state_set "$NAME" connected_since "$NOW"
      _state_transit "$NAME" connected 'adopted an existing session'
    else
      _state_set "$NAME" pid 0
      if [[ "${_CFG[${NAME}.enabled]}" == 'false' ]] \
         && [[ ! -f "${_RUN_DIR}/state/${NAME}.desired" ]]; then
        _state_transit "$NAME" disabled
      else
        _state_transit "$NAME" stopped
      fi
    fi
    _state_set "$NAME" next_check_at $(( NOW + I % INTERVAL ))
    I=$(( I + 1 ))
  done
  _state_flush_dirty
  return 0
}
#}}}

# 希望状態と現在の状態を突き合わせる (DESIGN 5.7)
_daemon_reconcile() { #{{{
  local NAME D S ADDR PORT
  for NAME in "${_CFG_NAMES[@]}"; do
    [[ -n "${_CFG_INVALID[$NAME]}" ]] && continue
    D=$(_desired_get "$NAME")
    S=${_ST[${NAME}.status]}
    if [[ "$D" == 'up' ]]; then
      case "$S" in
        stopped|disabled|failed)
          ADDR=$(_probe_addr "$NAME")
          PORT=${_CFG[${NAME}.local_port]}
          _state_set "$NAME" retry_count 0
          _state_set "$NAME" backoff "${_GLOBAL[retry_initial]}"
          _state_set "$NAME" next_retry_at 0
          if ! _is_port_free "$ADDR" "$PORT"; then
            _state_set "$NAME" last_error "$(_err_port_in_use "$NAME" "$PORT")"
            _log_error "$NAME" "$(_err_port_in_use "$NAME" "$PORT")"
            _state_transit "$NAME" failed 'local port already in use'
          else
            _ssh_start "$NAME"
          fi ;;
      esac
    else
      case "$S" in
        connected|connecting|retrying)
          _ssh_stop "$NAME"
          _state_transit "$NAME" stopped ;;
      esac
    fi
  done
  return 0
}
#}}}

# 再試行状態へ入る (指数バックオフ / SPECS 5.3)
_enter_retrying() { #{{{
  local NAME=$1 NOW=$2 RC BO
  RC=$(( _ST[${NAME}.retry_count] + 1 ))
  if (( RC == 1 )); then
    BO=${_GLOBAL[retry_initial]}
  else
    BO=$(( _ST[${NAME}.backoff] * 2 ))
    (( BO < _GLOBAL[retry_initial] )) && BO=${_GLOBAL[retry_initial]}
    (( BO > _GLOBAL[retry_max] )) && BO=${_GLOBAL[retry_max]}
  fi
  _state_set "$NAME" retry_count "$RC"
  _state_set "$NAME" backoff "$BO"
  _state_set "$NAME" next_retry_at $(( NOW + BO ))
  _state_transit "$NAME" retrying
  _log_info "$NAME" "reconnecting in ${BO}s (attempt ${RC})"
  return 0
}
#}}}

# 1 エントリ 1 サイクル分の状態遷移 (DESIGN 5.7 / SPECS 5.1)
_daemon_tick_entry() { #{{{
  local NAME=$1 NOW=$2 ST ADDR PORT MSG HINT CLASS RC INTERVAL
  ST=${_ST[${NAME}.status]}
  ADDR=$(_probe_addr "$NAME")
  PORT=${_CFG[${NAME}.local_port]}
  INTERVAL=${_CFG[${NAME}.check_interval]}

  case "$ST" in
    connected)
      (( NOW < _ST[${NAME}.next_check_at] )) && return 0
      (( _CHECKS_THIS_TICK >= _MAX_CHECKS_PER_TICK )) && return 0
      _CHECKS_THIS_TICK=$(( _CHECKS_THIS_TICK + 1 ))
      if _health_check "$NAME"; then
        _state_set "$NAME" next_check_at $(( NOW + INTERVAL ))
        # 60 秒以上継続したらバックオフをリセットする (SPECS 5.3)
        if (( NOW - _ST[${NAME}.connected_since] >= 60 )) && (( _ST[${NAME}.retry_count] > 0 )); then
          _state_set "$NAME" retry_count 0
          _state_set "$NAME" backoff "${_GLOBAL[retry_initial]}"
        fi
      else
        _log_warn "$NAME" "health check failed (${_CFG[${NAME}.check_mode]} ${ADDR}:${PORT})"
        _state_set "$NAME" last_error "health check failed (${_CFG[${NAME}.check_mode]} ${ADDR}:${PORT})"
        _ssh_stop "$NAME"
        _enter_retrying "$NAME" "$NOW"
      fi ;;

    connecting)
      if ! _ssh_is_alive "$NAME"; then
        MSG=$(_ssh_take_error "$NAME")
        [[ -z "$MSG" ]] && MSG='ssh exited unexpectedly'
        _state_set "$NAME" pid 0
        _state_set "$NAME" last_error "$MSG"
        _log_error "$NAME" "ssh exited: ${MSG}"
        HINT=$(_ssh_error_hint "$NAME" "$MSG")
        [[ -n "$HINT" ]] && _log_error "$NAME" "$HINT"
        CLASS=$(_ssh_classify_error "$MSG")
        if [[ "$CLASS" == 'fatal' ]]; then
          _state_transit "$NAME" failed "$MSG"
        else
          _enter_retrying "$NAME" "$NOW"
        fi
        return 0
      fi
      # 確立の判定は check_mode に関わらず tcp 相当で行う (DESIGN 5.6)
      _probe_tcp "$ADDR" "$PORT"
      RC=$?
      if (( RC == 0 || RC == 2 )); then
        _state_transit "$NAME" connected
        _state_set "$NAME" connected_since "$NOW"
        _state_set "$NAME" next_check_at $(( NOW + INTERVAL ))
        _log_info "$NAME" "connection established (pid=${_ST[${NAME}.pid]})"
      elif (( NOW - _ST[${NAME}.since] >= _GLOBAL[connect_timeout] + 2 )); then
        _ssh_stop "$NAME"
        _state_set "$NAME" last_error "connection did not become ready within ${_GLOBAL[connect_timeout]}s"
        _log_warn "$NAME" "connection did not become ready within ${_GLOBAL[connect_timeout]}s"
        _enter_retrying "$NAME" "$NOW"
      fi ;;

    retrying)
      (( NOW < _ST[${NAME}.next_retry_at] )) && return 0
      if (( _GLOBAL[retry_limit] > 0 && _ST[${NAME}.retry_count] >= _GLOBAL[retry_limit] )); then
        _state_set "$NAME" last_error "retry limit (${_GLOBAL[retry_limit]}) reached"
        _state_transit "$NAME" failed 'retry limit reached'
        return 0
      fi
      # ローカルポートが他プロセスに使われている場合は再試行しない (SPECS 5.3)
      if ! _is_port_free "$ADDR" "$PORT"; then
        _state_set "$NAME" last_error "$(_err_port_in_use "$NAME" "$PORT")"
        _log_error "$NAME" "$(_err_port_in_use "$NAME" "$PORT")"
        _state_transit "$NAME" failed 'local port already in use'
        return 0
      fi
      _ssh_start "$NAME" ;;

    stopped|disabled|failed)
      : ;;   # デーモンからは何もしない。desired の変更でのみ復帰する
  esac
  return 0
}
#}}}

# 設定を読み直して差分を反映する (SPECS 5.5)
_daemon_reload() { #{{{
  local NAME SIG ADDED=0 REMOVED=0 RESTARTED=0 DISABLED=0
  local -a OLD_NAMES=("${_CFG_NAMES[@]}")

  _OPT_CONFIG=$_CONFIG_FILE
  # 先にサブシェルで検証し、失敗したら旧設定を維持する (デーモンは落とさない)
  if ! ( _NO_CFG_WARN=yes; _config_reset; _config_setup ) >/dev/null 2>&1; then
    _log_error - 'config reload failed; keeping the previous configuration'
    return 1
  fi
  _NO_CFG_WARN=yes
  _config_reset
  _config_setup
  _NO_CFG_WARN=

  for NAME in "${_CFG_NAMES[@]}"; do
    if ! _in_array "$NAME" "${OLD_NAMES[@]}"; then
      ADDED=$(( ADDED + 1 ))
      _state_load "$NAME"
      _state_set "$NAME" pid 0
      if [[ -n "${_CFG_INVALID[$NAME]}" ]]; then
        _state_set "$NAME" last_error "${_CFG_INVALID[$NAME]}"
        _state_transit "$NAME" failed 'invalid configuration'
      elif [[ "${_CFG[${NAME}.enabled]}" == 'false' ]]; then
        _state_transit "$NAME" disabled
      else
        _state_transit "$NAME" stopped
      fi
      continue
    fi
    if [[ -n "${_CFG_INVALID[$NAME]}" ]]; then
      _ssh_stop "$NAME"
      _state_set "$NAME" last_error "${_CFG_INVALID[$NAME]}"
      _state_transit "$NAME" failed 'invalid configuration'
      continue
    fi
    if [[ "${_CFG[${NAME}.enabled]}" == 'false' ]]; then
      if [[ "${_ST[${NAME}.status]}" != 'disabled' ]]; then
        _ssh_stop "$NAME"
        _desired_remove "$NAME"
        _state_transit "$NAME" disabled 'disabled by config'
        DISABLED=$(( DISABLED + 1 ))
      fi
      continue
    fi
    SIG=$(_conn_sig "$NAME")
    if [[ "$SIG" != "${_ST[${NAME}.conn_sig]}" ]]; then
      case "${_ST[${NAME}.status]}" in
        connected|connecting|retrying)
          _ssh_stop "$NAME"
          _state_transit "$NAME" stopped 'connection parameters changed'
          RESTARTED=$(( RESTARTED + 1 )) ;;
      esac
    fi
  done

  for NAME in "${OLD_NAMES[@]}"; do
    _in_array "$NAME" "${_CFG_NAMES[@]}" && continue
    _ssh_stop "$NAME"
    _state_remove "$NAME"
    REMOVED=$(( REMOVED + 1 ))
  done

  _log_init
  _daemon_reconcile
  _state_flush_dirty
  _RELOAD_COUNT=$(( _RELOAD_COUNT + 1 ))
  _daemon_write_meta
  _log_info - "config reloaded (added=${ADDED}, removed=${REMOVED}, restarted=${RESTARTED}, disabled=${DISABLED})"
  return 0
}
#}}}

# 全セッションを停止して終了する (SPECS 5.4)
_daemon_shutdown() { #{{{
  local NAME
  _log_info - 'shutting down'
  for NAME in "${_CFG_NAMES[@]}"; do
    case "${_ST[${NAME}.status]}" in
      connected|connecting|retrying)
        _ssh_stop "$NAME"
        _state_transit "$NAME" stopped ;;
      *)
        _ssh_stop "$NAME" ;;
    esac
  done
  _state_flush_dirty
  rm -f "${_RUN_DIR}/daemon.pid" "${_RUN_DIR}/daemon.meta" 2>/dev/null
  _daemon_lock_release
  _log_info - 'daemon stopped'
  return 0
}
#}}}

# デーモン本体 (DESIGN 5.7)
_daemon_main() { #{{{
  local NAME NOW
  umask 077
  if ! _daemon_lock_acquire; then
    _error_exit "$_EXIT_RUNNING" "$(_err_daemon_running "$_DAEMON_RUNNING_PID")"
  fi
  _DAEMON_STARTED=$(_now)
  printf '%s\n' "$$" > "${_RUN_DIR}/daemon.pid"
  trap '_on_term' TERM INT
  trap '_on_hup' HUP
  trap '_on_usr1' USR1

  _log_init
  _probe_detect
  _daemon_init_states
  _daemon_reconcile
  _state_flush_dirty
  _daemon_write_meta
  _log_info - "daemon started (pid=$$, entries=${#_CFG_NAMES[@]})"

  while [[ -z "$_SHUTDOWN" ]]; do
    if (( _FLAG_HUP )); then
      _FLAG_HUP=0
      _daemon_reload
    fi
    if (( _FLAG_USR1 )); then
      _FLAG_USR1=0
      _daemon_reconcile
    fi
    NOW=$(_now)
    _CHECKS_THIS_TICK=0
    for NAME in "${_CFG_NAMES[@]}"; do
      _daemon_tick_entry "$NAME" "$NOW"
    done
    _state_flush_dirty
    # 終了した ssh を回収する (ゾンビを kill -0 で生存と誤判定しないため)
    jobs > /dev/null 2>&1
    sleep 1
  done

  _daemon_shutdown
  return 0
}
#}}}
#}}}

