#!/usr/bin/env bash
#===============================================================================
# pfwd : persistent SSH port forwarding
#===============================================================================
# shellcheck disable=SC2006

#- bash version check ----------------------------------------------------------
# bash 4.x is required because associative arrays are used (DESIGN 1.1 / 7.2).
# declare -g is used for global declarations (so that they are declared globally
# even when sourced from inside a function by bats), so the minimum is 4.2.
# The check must run before the declare statements below, so it is done here, not in a function.
if [[ -z "${BASH_VERSINFO[0]}" ]] \
  || (( BASH_VERSINFO[0] < 4 || ( BASH_VERSINFO[0] == 4 && BASH_VERSINFO[1] < 2 ) )); then
  echo "[ ERROR ] bash 4.2 or later is required (current: ${BASH_VERSION:-unknown}). On macOS: brew install bash" >&2
  exit 7
fi

#-------------------------------------------------------------------------------
#- common global variables -----------------------------------------------------
__SCRIPT_BASE=$(cd "$(dirname "$0")" || exit; pwd)
__SCRIPT_NAME=$(basename "$0")

# Temporary directory for this process. The path is fixed here, at script scope,
# so that both __make_tmp (which may run inside a command substitution) and
# __script_end_clean_tmp (which runs from the EXIT trap) agree on it.
# The directory itself is created lazily by __make_tmp.
# Plain -d tests instead of uname: this is evaluated on every run, including the
# ones that never need a temporary file.
if [[ -d /dev/shm ]]; then
  __TMP_BASE="/dev/shm/tmp.${__SCRIPT_NAME}.$$"
elif [[ -d /Volumes/Ramdisk ]]; then
  __TMP_BASE="/Volumes/Ramdisk/tmp.${__SCRIPT_NAME}.$$"
else
  __TMP_BASE="${TMPDIR:-/tmp}/tmp.${__SCRIPT_NAME}.$$"
fi

__SILENT=

#-------------------------------------------------------------------------------
#- global variables ------------------------------------------------------------
#{{{
_VERSION='0.2.0'

