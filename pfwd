#-------------------------------------------------------------------------------
#- argument parsing ------------------------------------------------------------
#{{{
# a simple scheme that only maps a valueless --foo to _FOO=yes cannot handle options
# that take a value, such as --config <PATH>, so an integrated parser is used (DESIGN 5.9).
_parse_args() { #{{{
  while (( $# > 0 )); do
    case "$1" in
      -c|--config)
        [[ $# -lt 2 ]] && _usage "option requires an argument: $1"
        _OPT_CONFIG=$2; shift 2 ;;
      --config=*)   _OPT_CONFIG=${1#*=}; shift ;;
      -v|--verbose) _VERBOSE=$(( _VERBOSE + 1 )); shift ;;
      -vv)          _VERBOSE=2; shift ;;
      -q|--quiet)   _QUIET=yes; shift ;;
      --no-color)   _NO_COLOR=yes; shift ;;
      -h|--help)    _OPT_HELP=yes; shift ;;
      -V|--version) _OPT_VERSION=yes; shift ;;
      --)           shift
                    while (( $# > 0 )); do _ARGS+=("$1"); shift; done
                    break ;;
      # subcommand-specific options are parsed by each _cmd_*
      --init|--force|--user|--system|--now|--exit-code|-f)
                    _SUBCMD_OPTS+=("$1"); shift ;;
      --run-as)
        [[ $# -lt 2 ]] && _usage "option requires an argument: $1"
        _SUBCMD_OPTS+=("$1" "$2"); shift 2 ;;
      --run-as=*)   _SUBCMD_OPTS+=("$1"); shift ;;
      -*)           _usage "unknown option: $1" ;;
      *)
        if [[ -z "$_SUBCMD" ]]; then
          _SUBCMD=$1
          _SUBCMD_GIVEN=yes
        else
          _ARGS+=("$1")
        fi
        shift ;;
    esac
  done
  # SPECS 3.1: no arguments means status
  [[ -z "$_SUBCMD" ]] && _SUBCMD=status
  return 0
}
#}}}

# check that the required commands exist (DESIGN 7.2)
_check_prerequisites() { #{{{
  local CMD
  for CMD in ssh yq; do
    command -v "$CMD" >/dev/null 2>&1 || _error_exit "$_EXIT_DEPS" "$(_err_no_command "$CMD")"
  done
  return 0
}
#}}}
#}}}

#-------------------------------------------------------------------------------
#- Main process ----------------------------------------------------------------
#-------------------------------------------------------------------------------
# in tests (bats) only the function definitions are loaded
[[ -n "$PFWD_SOURCE_ONLY" ]] && return 0

umask 077
__setup
_parse_args "$@"

[[ -z "$_NO_COLOR" && -z "$_NO_TTY" ]] && __setup_color
[[ -n "$_QUIET" ]] && __SILENT=yes

if [[ -n "$_OPT_VERSION" ]]; then
  _cmd_version
  exit "$_EXIT_OK"
fi

if [[ -n "$_OPT_HELP" ]]; then
  if [[ -n "$_SUBCMD_GIVEN" ]]; then
    _cmd_help "$_SUBCMD"
  else
    _cmd_help ''
  fi
  exit "$_EXIT_OK"
fi

case "$_SUBCMD" in
  version)
    _cmd_version ;;
  help)
    _cmd_help "${_ARGS[0]}" ;;
  config)
    _cmd_config ;;
  list)
    _check_prerequisites
    _config_setup
    _cmd_list ;;
  daemon)
    _check_prerequisites
    _config_setup
    _setup_runtime_dir
    _cmd_daemon ;;
  status)
    _check_prerequisites
    _config_setup
    _setup_runtime_dir
    _cmd_status ;;
  start)
    _check_prerequisites
    _config_setup
    _setup_runtime_dir
    _cmd_start ;;
  stop)
    _check_prerequisites
    _config_setup
    _setup_runtime_dir
    _cmd_stop ;;
  restart)
    _check_prerequisites
    _config_setup
    _setup_runtime_dir
    _cmd_restart ;;
  up)
    _check_prerequisites
    _config_setup
    _setup_runtime_dir
    _cmd_up ;;
  down)
    _check_prerequisites
    _config_setup
    _setup_runtime_dir
    _cmd_down ;;
  reload)
    _check_prerequisites
    _config_setup
    _setup_runtime_dir
    _cmd_reload ;;
  logs)
    _check_prerequisites
    _config_setup
    _setup_runtime_dir
    _cmd_logs ;;
  test)
    _check_prerequisites
    # test prints the validation results line by line itself, so suppress warnings at load time
    _NO_CFG_WARN=yes
    _config_setup
    _NO_CFG_WARN=
    _setup_runtime_dir
    _cmd_test ;;
  install-service)
    _check_prerequisites
    # _config_setup runs inside the command: --system is only known after
    # the subcommand options have been scanned
    _cmd_install_service ;;
  uninstall-service)
    _cmd_uninstall_service ;;
  *)
    _usage "unknown subcommand: ${_SUBCMD}" ;;
esac
_RC=$?

exit "$_RC"

