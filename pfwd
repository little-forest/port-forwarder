#{{{
# SSH destination notation of an entry (user@host[:port])
_ssh_label() { #{{{
  local NAME=$1 U H P L
  U=${_CFG[${NAME}.user]}
  H=${_CFG[${NAME}.host]}
  P=${_CFG[${NAME}.port]}
  [[ -n "$U" ]] && L="${U}@${H}" || L=$H
  [[ -n "$P" && "$P" != '22' ]] && L="${L}:${P}"
  printf '%s\n' "$L"
}
#}}}

_cmd_list() { #{{{
  local NAME EN
  _calc_name_width "${_CFG_NAMES[@]}"
  printf '%-*s  %-7s  %-27s  %-15s  %s\n' \
    "$_NAME_WIDTH" 'NAME' 'ENABLED' 'SSH' 'LOCAL' 'REMOTE'
  for NAME in "${_CFG_NAMES[@]}"; do
    if [[ "${_CFG[${NAME}.enabled]}" == 'false' ]]; then EN=no; else EN=yes; fi
    printf '%-*s  %-7s  %-27s  %-15s  %s\n' \
      "$_NAME_WIDTH" "$NAME" "$EN" \
      "$(_truncate "$(_ssh_label "$NAME")" 26)" \
      "${_CFG[${NAME}.bind_address]}:${_CFG[${NAME}.local_port]}" \
      "${_CFG[${NAME}.remote_host]}:${_CFG[${NAME}.remote_port]}"
  done
  return 0
}
#}}}

# decide where 'config --init' writes (SPECS 4.5)
_config_init_target() { #{{{
  local SYSTEM=$1
  if [[ -n "$_OPT_CONFIG" ]]; then
    # -c wins; --system is ignored, but not silently
    [[ -n "$SYSTEM" ]] && __show_warn '--system is ignored because --config was given'
    _expand_tilde "$_OPT_CONFIG"
    return 0
  fi
  if [[ -n "$SYSTEM" ]]; then
    _require_linux
    printf '%s\n' "$_SYSTEM_CONFIG"
    return 0
  fi
  _config_user_path
}
#}}}

_cmd_config() { #{{{
  local OPT TARGET F INIT='' FORCE='' SYSTEM=''
  # the destination is given with -c/--config, never as a positional argument
  (( ${#_ARGS[@]} > 0 )) && _usage "$(_err_config_no_args)"
  for OPT in "${_SUBCMD_OPTS[@]}"; do
    case "$OPT" in
      --init)   INIT=yes ;;
      --force)  FORCE=yes ;;
      --system) SYSTEM=yes ;;
      *)        _usage "unknown option for 'config': ${OPT}" ;;
    esac
  done
  # --system only decides where --init writes; it means nothing on its own
  [[ -n "$SYSTEM" && -z "$INIT" ]] && _usage "$(_err_system_needs_init)"
  if [[ -n "$INIT" ]]; then
    # the command substitution runs in a subshell, so _require_linux's exit
    # inside _config_init_target only ends that subshell; propagate it here
    TARGET=$(_config_init_target "$SYSTEM") || exit "$?"
    _config_init "$TARGET" "$FORCE"
    return 0
  fi
  _config_find
  _config_file_list
  for F in "${_CONFIG_FILES[@]}"; do
    printf '%s\n' "$F"
  done
  return 0
}
#}}}

# resolve the entry names to operate on (DESIGN 5.9)
_resolve_names() { #{{{
  local NAME
  _TARGETS=()
  if (( ${#_ARGS[@]} == 0 )); then
    if [[ "$_SUBCMD" == 'start' ]]; then
      # when omitted, only entries that are enabled and valid (SPECS 3.1)
      for NAME in "${_CFG_NAMES[@]}"; do
        [[ -n "${_CFG_INVALID[$NAME]}" ]] && continue
        [[ "${_CFG[${NAME}.enabled]}" == 'false' ]] && continue
        _TARGETS+=("$NAME")
      done
    else
      _TARGETS=("${_CFG_NAMES[@]}")
    fi
    return 0
  fi
  for NAME in "${_ARGS[@]}"; do
    _in_array "$NAME" "${_CFG_NAMES[@]}" || _error_exit "$_EXIT_USAGE" "$(_err_no_entry "$NAME")"
    _TARGETS+=("$NAME")
  done
  return 0
}
#}}}

# absolute path of the executable
_self_path() { #{{{
  local P=$0
  if [[ "$P" != /* ]]; then
    P="${__SCRIPT_BASE}/${__SCRIPT_NAME}"
  fi
  printf '%s\n' "$P"
}
#}}}

_status_color() { #{{{
  case "$1" in
    connected)            printf '%s' "$C_GREEN" ;;
    connecting|retrying)  printf '%s' "$C_YELLOW" ;;
    failed)               printf '%s' "$C_RED" ;;
    *)                    printf '%s' "$C_GREY" ;;
  esac
}
#}}}

# note appended to an entry line (shows the situation when there is no description)
_status_note() { #{{{
  local NAME=$1 ST=$2 NOW=$3 D
  D=${_CFG[${NAME}.description]}
  if [[ -n "$D" ]]; then
    printf '%s\n' "$D"
    return 0
  fi
  case "$ST" in
    retrying)
      printf 'next retry in %ss\n' "$(( _ST[${NAME}.next_retry_at] - NOW ))" ;;
    failed)
      printf '%s\n' "${_ST[${NAME}.last_error]}" ;;
    *)
      printf '\n' ;;
  esac
}
#}}}

# determine the display status of an entry as seen from the CLI
_display_status() { #{{{
  local NAME=$1 DAEMON_UP=$2 ST
  ST=${_ST[${NAME}.status]}
  if [[ -n "${_CFG_INVALID[$NAME]}" ]]; then
    printf 'failed\n'
    return 0
  fi
  if [[ -z "$DAEMON_UP" ]]; then
    # when the daemon is not running, judge by the presence of the real process (DESIGN 5.9)
    case "$ST" in
      connected|connecting|retrying)
        if [[ -n "${_ST[${NAME}.ctl]}" && -S "${_ST[${NAME}.ctl]}" ]] \
           && _ssh_pid_alive "${_ST[${NAME}.pid]}"; then
          printf '%s\n' "$ST"
        else
          printf 'stopped\n'
        fi
        return 0 ;;
    esac
  fi
  printf '%s\n' "$ST"
  return 0
}
#}}}

_cmd_status() { #{{{
  local OPT NAME ST NOW DPID NOTE UPTIME RETRY DAEMON_UP='' WITH_EXIT_CODE=''
  local -A COUNT=()
  local NOT_CONNECTED=0
  for OPT in "${_SUBCMD_OPTS[@]}"; do
    case "$OPT" in
      --exit-code) WITH_EXIT_CODE=yes ;;
      *)           _usage "unknown option for 'status': ${OPT}" ;;
    esac
  done
  _resolve_names
  _calc_name_width "${_TARGETS[@]}"
  NOW=$(_now)
  if DPID=$(_daemon_pid); then
    DAEMON_UP=yes
  else
    printf 'daemon: not running\n'
  fi

  printf '%-*s  %-10s  %-15s  %-27s  %-10s%5s  %s\n' \
    "$_NAME_WIDTH" 'NAME' 'STATUS' 'LOCAL' 'REMOTE' 'UPTIME' 'RETRY' 'DESCRIPTION'

  for NAME in "${_TARGETS[@]}"; do
    _state_load "$NAME"
    ST=$(_display_status "$NAME" "$DAEMON_UP")
    COUNT[$ST]=$(( ${COUNT[$ST]:-0} + 1 ))
    [[ "$ST" != 'connected' ]] && NOT_CONNECTED=$(( NOT_CONNECTED + 1 ))
    if [[ "$ST" == 'connected' ]] && (( _ST[${NAME}.connected_since] > 0 )); then
      UPTIME=$(_fmt_uptime $(( NOW - _ST[${NAME}.connected_since] )))
    else
      UPTIME='-'
    fi
    if [[ "$ST" == 'disabled' ]]; then
      RETRY='-'
    else
      RETRY=${_ST[${NAME}.retry_count]}
    fi
    if [[ -n "${_CFG_INVALID[$NAME]}" ]]; then
      NOTE=${_CFG_INVALID[$NAME]}
    else
      NOTE=$(_status_note "$NAME" "$ST" "$NOW")
    fi
    printf '%-*s  %s%-10s%s  %-15s  %-27s  %-10s%5s  %s\n' \
      "$_NAME_WIDTH" "$NAME" \
      "$(_status_color "$ST")" "$ST" "$C_OFF" \
      "${_CFG[${NAME}.bind_address]}:${_CFG[${NAME}.local_port]}" \
      "${_CFG[${NAME}.remote_host]}:${_CFG[${NAME}.remote_port]}" \
      "$UPTIME" "$RETRY" "$NOTE"
  done

  # summary line
  local S SUMMARY=''
  for S in connected connecting retrying stopped disabled failed; do
    (( ${COUNT[$S]:-0} > 0 )) || continue
    [[ -n "$SUMMARY" ]] && SUMMARY="${SUMMARY}, "
    SUMMARY="${SUMMARY}${COUNT[$S]} ${S}"
  done
  printf '\n%d entries: %s\n' "${#_TARGETS[@]}" "$SUMMARY"

  if [[ -n "$WITH_EXIT_CODE" ]] && (( NOT_CONNECTED > 0 )); then
    exit "$_EXIT_CONNECT"
  fi
  return 0
}
#}}}

# after writing desired, wait for the state to change and print the result (DESIGN 5.9)
_wait_result() { #{{{
  local EXPECT=$1 TIMEOUT=$2
  shift 2
  local -a NAMES=("$@")
  local -A SETTLED=()
  local NAME ST I MAX ALL
  _WAIT_OK=0
  _WAIT_NG=0
  (( ${#NAMES[@]} == 0 )) && return 0
  MAX=$(( TIMEOUT * 5 ))   # 0.2 second interval
  for (( I = 0; I <= MAX; I++ )); do
    ALL=1
    for NAME in "${NAMES[@]}"; do
      [[ -n "${SETTLED[$NAME]}" ]] && continue
      _state_load "$NAME"
      ST=${_ST[${NAME}.status]}
      if [[ "$ST" == "$EXPECT" || "$ST" == 'failed' ]]; then
        SETTLED[$NAME]=$ST
      else
        ALL=0
      fi
    done
    (( ALL )) && break
    sleep 0.2
  done
  for NAME in "${NAMES[@]}"; do
    _state_load "$NAME"
    ST=${SETTLED[$NAME]:-${_ST[${NAME}.status]}}
    if [[ "$ST" == "$EXPECT" ]]; then
      if [[ "$EXPECT" == 'connected' ]]; then
        _show_result OK "$NAME" "connected (${_CFG[${NAME}.bind_address]}:${_CFG[${NAME}.local_port]} -> ${_CFG[${NAME}.remote_host]}:${_CFG[${NAME}.remote_port]})"
      else
        _show_result OK "$NAME" "$ST"
      fi
      _WAIT_OK=$(( _WAIT_OK + 1 ))
    elif [[ "$ST" == 'failed' ]]; then
      _show_result FAILED "$NAME" "${_ST[${NAME}.last_error]:-failed}"
      _WAIT_NG=$(( _WAIT_NG + 1 ))
    else
      _show_result FAILED "$NAME" "timed out waiting for '${EXPECT}' (current: ${ST})"
      _WAIT_NG=$(( _WAIT_NG + 1 ))
    fi
  done
  return 0
}
#}}}

# check that the daemon is alive and put its PID into _DAEMON_PID.
# returning it on stdout would only allow exiting inside a command substitution, so use a variable.
_require_daemon() { #{{{
  _DAEMON_PID=$(_daemon_pid) || _error_exit "$_EXIT_NO_DAEMON" "$(_err_no_daemon)"
  return 0
}
#}}}

_cmd_start() { #{{{
  local NAME DPID SKIP=0
  local -a WAITING=()
  _require_daemon
  DPID=$_DAEMON_PID
  _resolve_names
  _calc_name_width "${_TARGETS[@]}"
  for NAME in "${_TARGETS[@]}"; do
    _state_load "$NAME"
    if [[ -n "${_CFG_INVALID[$NAME]}" ]]; then
      _show_result FAILED "$NAME" "${_CFG_INVALID[$NAME]}"
      continue
    fi
    if [[ "${_ST[${NAME}.status]}" == 'connected' ]]; then
      _show_result SKIP "$NAME" 'already connected'
      SKIP=$(( SKIP + 1 ))
      continue
    fi
    if ! _desired_set "$NAME" up; then
      _show_result FAILED "$NAME" 'cannot write the desired state file'
      continue
    fi
    WAITING+=("$NAME")
  done
  (( ${#WAITING[@]} > 0 )) && kill -USR1 "$DPID" 2>/dev/null
  _wait_result connected $(( _GLOBAL[connect_timeout] + 5 )) "${WAITING[@]}"
  local NG=$(( _WAIT_NG + ${#_TARGETS[@]} - ${#WAITING[@]} - SKIP ))
  [[ -z "$_QUIET" ]] && printf '%d started, %d failed\n' "$(( _WAIT_OK + SKIP ))" "$NG"
  (( NG > 0 )) && return "$_EXIT_CONNECT"
  return 0
}
#}}}

_cmd_stop() { #{{{
  local NAME DPID
  local -a WAITING=()
  _require_daemon
  DPID=$_DAEMON_PID
  _resolve_names
  _calc_name_width "${_TARGETS[@]}"
  for NAME in "${_TARGETS[@]}"; do
    _state_load "$NAME"
    if ! _desired_set "$NAME" down; then
      _show_result FAILED "$NAME" 'cannot write the desired state file'
      continue
    fi
    WAITING+=("$NAME")
  done
  (( ${#WAITING[@]} > 0 )) && kill -USR1 "$DPID" 2>/dev/null
  _wait_result stopped 10 "${WAITING[@]}"
  local NG=$(( _WAIT_NG + ${#_TARGETS[@]} - ${#WAITING[@]} ))
  [[ -z "$_QUIET" ]] && printf '%d stopped, %d failed\n' "$_WAIT_OK" "$NG"
  (( NG > 0 )) && return "$_EXIT_CONNECT"
  return 0
}
#}}}

_cmd_restart() { #{{{
  local NAME DPID
  local -a WAITING=()
  _require_daemon
  DPID=$_DAEMON_PID
  _resolve_names
  _calc_name_width "${_TARGETS[@]}"
  # going down first and then up resets the backoff (SPECS 5.3)
  for NAME in "${_TARGETS[@]}"; do
    _state_load "$NAME"
    if [[ -n "${_CFG_INVALID[$NAME]}" ]]; then
      _show_result FAILED "$NAME" "${_CFG_INVALID[$NAME]}"
      continue
    fi
    _desired_set "$NAME" down || continue
    WAITING+=("$NAME")
  done
  if (( ${#WAITING[@]} == 0 )); then
    [[ -z "$_QUIET" ]] && printf '0 restarted, %d failed\n' "${#_TARGETS[@]}"
    return "$_EXIT_CONNECT"
  fi
  kill -USR1 "$DPID" 2>/dev/null
  _wait_stopped_quiet 10 "${WAITING[@]}"
  for NAME in "${WAITING[@]}"; do
    _desired_set "$NAME" up
  done
  kill -USR1 "$DPID" 2>/dev/null
  _wait_result connected $(( _GLOBAL[connect_timeout] + 5 )) "${WAITING[@]}"
  local NG=$(( _WAIT_NG + ${#_TARGETS[@]} - ${#WAITING[@]} ))
  [[ -z "$_QUIET" ]] && printf '%d restarted, %d failed\n' "$_WAIT_OK" "$NG"
  (( NG > 0 )) && return "$_EXIT_CONNECT"
  return 0
}
#}}}

# wait for the stop to finish without printing (used in the first half of restart)
_wait_stopped_quiet() { #{{{
  local TIMEOUT=$1
  shift
  local -a NAMES=("$@")
  local NAME I MAX ALL ST
  MAX=$(( TIMEOUT * 5 ))
  for (( I = 0; I <= MAX; I++ )); do
    ALL=1
    for NAME in "${NAMES[@]}"; do
      _state_load "$NAME"
      ST=${_ST[${NAME}.status]}
      [[ "$ST" == 'stopped' || "$ST" == 'failed' || "$ST" == 'disabled' ]] || ALL=0
    done
    (( ALL )) && return 0
    sleep 0.2
  done
  return 1
}
#}}}

_cmd_up() { #{{{
  local PID I SELF
  local -a CMD=()
  if PID=$(_daemon_pid); then
    _error_exit "$_EXIT_RUNNING" "$(_err_daemon_running "$PID")"
  fi
  SELF=$(_self_path)
  CMD=("$SELF" --config "$_CONFIG_FILE")
  [[ -n "$_NO_COLOR" ]] && CMD+=(--no-color)
  CMD+=(daemon)
  _debug "starting daemon: ${CMD[*]}"
  if command -v setsid >/dev/null 2>&1; then
    setsid "${CMD[@]}" </dev/null >/dev/null 2>&1 &
  else
    # nohup is not used because it leaves SIGHUP ignored, which would keep reload (SIGHUP)
    # from being received. Only SIGINT from the terminal is ignored in a subshell.
    ( trap '' INT; exec "${CMD[@]}" ) </dev/null >/dev/null 2>&1 &
  fi
  disown 2>/dev/null
  for (( I = 0; I < 50; I++ )); do
    if PID=$(_daemon_pid); then
      __show_info "daemon started (pid=${PID})"
      return 0
    fi
    sleep 0.1
  done
  _error_exit "$_EXIT_ERROR" "daemon did not start within 5s. Run '${__SCRIPT_NAME} daemon' in the foreground to see why."
}
#}}}

_cmd_down() { #{{{
  local PID I NAME CTL
  if ! PID=$(_daemon_pid); then
    __show_info 'daemon is not running'
    return 0
  fi
  kill -TERM "$PID" 2>/dev/null
  for (( I = 0; I < 150; I++ )); do
    kill -0 "$PID" 2>/dev/null || break
    sleep 0.1
  done
  if kill -0 "$PID" 2>/dev/null; then
    __show_warn "daemon (pid=${PID}) did not stop within 15s; sending SIGKILL"
    kill -KILL "$PID" 2>/dev/null
    sleep 0.5
    # clean up the remaining sessions via ControlPath
    for NAME in "${_CFG_NAMES[@]}"; do
      _state_load "$NAME"
      CTL=${_ST[${NAME}.ctl]}
      [[ -n "$CTL" && -S "$CTL" ]] || continue
      ssh -O exit -S "$CTL" -o BatchMode=yes "${_CFG[${NAME}.host]}" >/dev/null 2>&1
      _ssh_stop "$NAME"
    done
    rm -f "${_RUN_DIR}/daemon.pid" "${_RUN_DIR}/daemon.meta" 2>/dev/null
    rm -rf "${_RUN_DIR}/daemon.lock" 2>/dev/null
  fi
  __show_info 'daemon stopped'
  return 0
}
#}}}

_cmd_reload() { #{{{
  local PID OLD NEW I META="${_RUN_DIR}/daemon.meta"
  _require_daemon
  PID=$_DAEMON_PID
  # completion is detected by a content change of daemon.meta (not by mtime, whose granularity is 1 second)
  OLD=$(cat "$META" 2>/dev/null)
  kill -HUP "$PID" 2>/dev/null
  for (( I = 0; I < 50; I++ )); do
    NEW=$(cat "$META" 2>/dev/null)
    if [[ -n "$NEW" && "$NEW" != "$OLD" ]]; then
      __show_info 'config reloaded'
      return 0
    fi
    sleep 0.1
  done
  __show_warn "the daemon did not report the reload within 5s; check the log"
  return "$_EXIT_ERROR"
}
#}}}

_cmd_logs() { #{{{
  local OPT NAME LOG FOLLOW=''
  for OPT in "${_SUBCMD_OPTS[@]}"; do
    case "$OPT" in
      -f) FOLLOW=yes ;;
      *)  _usage "unknown option for 'logs': ${OPT}" ;;
    esac
  done
  LOG=${_GLOBAL[log_file]}
  if [[ -z "$LOG" ]]; then
    # explain how to read the log when it goes to stdout (SPECS 6.5)
    cat <<PFWD_LOGS_HINT
global.log_file is not set, so logs go to standard output.
  - systemd (user)  : journalctl --user -u port-forwarder -f
  - systemd (system): journalctl -u port-forwarder -f
  - macOS           : run '${__SCRIPT_NAME} daemon' in the foreground, or set global.log_file
PFWD_LOGS_HINT
    return 0
  fi
  LOG=$(_expand_tilde "$LOG")
  [[ -f "$LOG" ]] || _error_exit "$_EXIT_ERROR" "log file not found: ${LOG}"
  NAME=${_ARGS[0]}
  if [[ -n "$NAME" ]]; then
    _in_array "$NAME" "${_CFG_NAMES[@]}" || _error_exit "$_EXIT_USAGE" "$(_err_no_entry "$NAME")"
    if [[ -n "$FOLLOW" ]]; then
      tail -n 200 -f "$LOG" | grep --line-buffered -F "[${NAME}]"
    else
      grep -F "[${NAME}]" "$LOG"
    fi
    return 0
  fi
  if [[ -n "$FOLLOW" ]]; then
    tail -n 200 -f "$LOG"
  else
    tail -n 200 "$LOG"
  fi
  return 0
}
#}}}

# ssh reachability check for the connection test (no forward is set up / DESIGN 5.9)
_test_ssh_reach() { #{{{
  local NAME=$1 OUT RC OPT
  local -a ARGS=(ssh -T
    -o BatchMode=yes
    -o NumberOfPasswordPrompts=0
    -o StrictHostKeyChecking=yes
    -o ConnectTimeout="${_GLOBAL[connect_timeout]}"
    -p "${_CFG[${NAME}.port]}")
  [[ -n "${_CFG[${NAME}.identity]}" ]] && ARGS+=(-o IdentitiesOnly=yes -i "${_CFG[${NAME}.identity]}")
  [[ -n "${_CFG[${NAME}.user]}" ]] && ARGS+=(-l "${_CFG[${NAME}.user]}")
  _entry_ssh_options "$NAME"
  for OPT in "${_ENTRY_OPTS[@]}"; do
    ARGS+=(-o "$OPT")
  done
  ARGS+=("${_CFG[${NAME}.host]}" true)
  _debug2 "[${NAME}] exec: ${ARGS[*]}"
  OUT=$("${ARGS[@]}" 2>&1 </dev/null)
  RC=$?
  if (( RC != 0 )); then
    _TEST_ERR=$(_sanitize "$(printf '%s\n' "$OUT" | grep -v '^Warning: Permanently added' | tail -n 1)")
    [[ -z "$_TEST_ERR" ]] && _TEST_ERR="ssh exited with status ${RC}"
    return 1
  fi
  _TEST_ERR=
  return 0
}
#}}}

_cmd_test() { #{{{
  local NAME PASS=0 WARN=0 FAIL=0 NOTE ADDR PORT
  printf 'Config: %s\n' "$_CONFIG_FILE"
  local F
  for F in "${_CONFIG_FILES[@]:1}"; do
    printf '        %s\n' "$F"
  done
  _yq_detect
  printf 'yq:     %s\n' "$_YQ_VERSION"
  printf '\n'
  _resolve_names
  _calc_name_width "${_TARGETS[@]}"
  for NAME in "${_TARGETS[@]}"; do
    if [[ -n "${_CFG_INVALID[$NAME]}" ]]; then
      _show_result FAILED "$NAME" "${_CFG_INVALID[$NAME]}"
      FAIL=$(( FAIL + 1 ))
      continue
    fi
    _state_load "$NAME"
    if ! _test_ssh_reach "$NAME"; then
      _show_result FAILED "$NAME" "config valid, ssh unreachable: ${_TEST_ERR}"
      FAIL=$(( FAIL + 1 ))
      continue
    fi
    ADDR=$(_probe_addr "$NAME")
    PORT=${_CFG[${NAME}.local_port]}
    if _is_port_free "$ADDR" "$PORT"; then
      _show_result OK "$NAME" 'config valid, ssh reachable, local port free'
      PASS=$(( PASS + 1 ))
    else
      NOTE="config valid, ssh reachable, local port ${PORT} already in use"
      if [[ "${_ST[${NAME}.status]}" == 'connected' ]]; then
        NOTE="${NOTE} (by this entry)"
      fi
      _show_result WARN "$NAME" "$NOTE"
      WARN=$(( WARN + 1 ))
    fi
  done
  printf '\n%d passed, %d warning, %d failed\n' "$PASS" "$WARN" "$FAIL"
  (( FAIL > 0 )) && return "$_EXIT_CONNECT"
  return 0
}
#}}}

# generate the contents of the systemd unit (DESIGN 5.10)
_service_unit_text() { #{{{
  local SCOPE=$1 RUN_AS=$2 EXEC=$3
  cat <<PFWD_UNIT
[Unit]
Description=port-forwarder: persistent SSH port forwarding
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
ExecStart=${EXEC}
ExecReload=/bin/kill -HUP \$MAINPID
Restart=on-failure
RestartSec=10
KillMode=mixed
TimeoutStopSec=30
PFWD_UNIT
  [[ "$SCOPE" == 'system' && -n "$RUN_AS" ]] && printf 'User=%s\n' "$RUN_AS"
  printf '\n[Install]\n'
  if [[ "$SCOPE" == 'system' ]]; then
    printf 'WantedBy=multi-user.target\n'
  else
    printf 'WantedBy=default.target\n'
  fi
  return 0
}
#}}}

_cmd_install_service() { #{{{
  local OPT SCOPE=user RUN_AS='' NOW='' I UNIT_DIR UNIT EXEC
  local -a SYSTEMCTL=()
  if [[ "$(uname)" == 'Darwin' ]]; then
    _error_exit "$_EXIT_ERROR" "install-service is Linux (systemd) only. On macOS, run '${__SCRIPT_NAME} up' instead (SPECS 9)."
  fi
  for (( I = 0; I < ${#_SUBCMD_OPTS[@]}; I++ )); do
    OPT=${_SUBCMD_OPTS[$I]}
    case "$OPT" in
      --user)     SCOPE=user ;;
      --system)   SCOPE=system ;;
      --now)      NOW=yes ;;
      --run-as)   I=$(( I + 1 )); RUN_AS=${_SUBCMD_OPTS[$I]} ;;
      --run-as=*) RUN_AS=${OPT#*=} ;;
      *)          _usage "unknown option for 'install-service': ${OPT}" ;;
    esac
  done

  # --system looks at the system-wide config only; checked before _config_setup
  # so that _config_find cannot answer with _err_no_config's --system-less advice
  if [[ "$SCOPE" == 'system' && -z "$_OPT_CONFIG" ]]; then
    _require_linux
    [[ -f "$_SYSTEM_CONFIG" ]] \
      || _error_exit "$_EXIT_CONFIG" "$(_err_no_system_config "$_SYSTEM_CONFIG")"
    # pins _config_find to /etc and puts --config into ExecStart below
    _OPT_CONFIG=$_SYSTEM_CONFIG
  fi
  _config_setup

  EXEC="$(_self_path) "
  [[ -n "$_OPT_CONFIG" ]] && EXEC="${EXEC}--config ${_CONFIG_FILE} "
  EXEC="${EXEC}daemon"

  if [[ "$SCOPE" == 'system' ]]; then
    UNIT_DIR=/etc/systemd/system
    SYSTEMCTL=(systemctl)
    [[ -z "$RUN_AS" ]] && __show_warn 'no --run-as given; the daemon will run as root (not recommended)'
  else
    UNIT_DIR="${XDG_CONFIG_HOME:-${HOME}/.config}/systemd/user"
    SYSTEMCTL=(systemctl --user)
  fi
  UNIT="${UNIT_DIR}/port-forwarder.service"
  if [[ ! -d "$UNIT_DIR" ]] && ! mkdir -p "$UNIT_DIR" 2>/dev/null; then
    _error_exit "$_EXIT_ERROR" "cannot create the unit directory: ${UNIT_DIR}"
  fi
  _service_unit_text "$SCOPE" "$RUN_AS" "$EXEC" > "$UNIT" \
    || _error_exit "$_EXIT_ERROR" "cannot write the unit file: ${UNIT}"
  printf 'Generated: %s\n' "$UNIT"

  if [[ -n "$NOW" ]]; then
    "${SYSTEMCTL[@]}" daemon-reload || _error_exit "$_EXIT_ERROR" 'systemctl daemon-reload failed'
    "${SYSTEMCTL[@]}" enable --now port-forwarder || _error_exit "$_EXIT_ERROR" 'systemctl enable --now failed'
    printf 'Enabled and started: port-forwarder\n'
    return 0
  fi
  printf 'Run the following to enable:\n'
  printf '  %s daemon-reload\n' "${SYSTEMCTL[*]}"
  printf '  %s enable --now port-forwarder\n' "${SYSTEMCTL[*]}"
  [[ "$SCOPE" == 'user' ]] && printf '  loginctl enable-linger %s    # to keep it running after logout\n' "${USER:-$(id -un)}"
  return 0
}
#}}}

_cmd_uninstall_service() { #{{{
  local OPT SCOPE=user UNIT_DIR UNIT
  local -a SYSTEMCTL=()
  if [[ "$(uname)" == 'Darwin' ]]; then
    _error_exit "$_EXIT_ERROR" "uninstall-service is Linux (systemd) only."
  fi
  for OPT in "${_SUBCMD_OPTS[@]}"; do
    case "$OPT" in
      --user)   SCOPE=user ;;
      --system) SCOPE=system ;;
      *)        _usage "unknown option for 'uninstall-service': ${OPT}" ;;
    esac
  done
  if [[ "$SCOPE" == 'system' ]]; then
    UNIT_DIR=/etc/systemd/system
    SYSTEMCTL=(systemctl)
  else
    UNIT_DIR="${XDG_CONFIG_HOME:-${HOME}/.config}/systemd/user"
    SYSTEMCTL=(systemctl --user)
  fi
  UNIT="${UNIT_DIR}/port-forwarder.service"
  [[ -f "$UNIT" ]] || _error_exit "$_EXIT_ERROR" "unit file not found: ${UNIT}"
  "${SYSTEMCTL[@]}" disable --now port-forwarder >/dev/null 2>&1
  rm -f "$UNIT" || _error_exit "$_EXIT_ERROR" "cannot remove the unit file: ${UNIT}"
  "${SYSTEMCTL[@]}" daemon-reload >/dev/null 2>&1
  printf 'Removed: %s\n' "$UNIT"
  return 0
}
#}}}

_cmd_daemon() { #{{{
  _daemon_main
}
