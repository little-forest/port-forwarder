#- bash version check ----------------------------------------------------------
# 連想配列を使うため bash 4 系が必須 (DESIGN 1.1 / 7.2)。
# グローバル宣言に declare -g を使う (bats から関数内で source されても
# グローバルに宣言されるようにするため) 都合上、下限は 4.2 とする。
# 後続の declare より前に判定する必要があるため、関数化せずここで実行する。
if [[ -z "${BASH_VERSINFO[0]}" ]] \
  || (( BASH_VERSINFO[0] < 4 || ( BASH_VERSINFO[0] == 4 && BASH_VERSINFO[1] < 2 ) )); then
  echo "[ ERROR ] bash 4.2 or later is required (current: ${BASH_VERSION:-unknown}). On macOS: brew install bash" >&2
  exit 7
fi

