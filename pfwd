#-------------------------------------------------------------------------------
#- config functions ------------------------------------------------------------
#{{{
# known keys (unknown keys only produce a warning / SPECS 4.4)
_KNOWN_ENTRY_KEYS=(description host user port identity local_port remote_host \
                   remote_port bind_address enabled check_mode check_interval ssh_options)
_KNOWN_GLOBAL_KEYS=(check_interval connect_timeout retry_initial retry_max retry_limit \
                    server_alive_interval server_alive_count_max log_file)
# file that receives yq's stderr (created lazily)
_YQ_ERR_FILE=
# yq implementation: 'go' (mikefarah/yq), 'python' (kislyuk/yq) or 'unknown'; empty until detected
_YQ_IMPL=
# human readable version, shown by the test subcommand
_YQ_VERSION=
# suppress validation warnings (the test subcommand prints them itself)
_NO_CFG_WARN=

# normalize the output of the yq 'type' operator (DESIGN 4.1)
# mikefarah/yq returns YAML tags (!!map ...), kislyuk/yq returns jq type names (object ...)
_yq_kind() { #{{{
  case "$1" in
    '!!map'|object)           printf 'map\n'    ;;
    '!!seq'|array)            printf 'seq\n'    ;;
    '!!null'|null|'')         printf 'null\n'   ;;
    '!!bool'|boolean)         printf 'bool\n'   ;;
    '!!int'|'!!float'|number) printf 'number\n' ;;
    '!!str'|string)           printf 'str\n'    ;;
    *)                        printf '%s\n' "$1" ;;
  esac
}
#}}}

# type predicates used inside the parse loops (no subshell / DESIGN 2.2)
_yq_is_map()  { [[ "$1" == '!!map' || "$1" == 'object' ]]; } #{{{
_yq_is_null() { [[ -z "$1" || "$1" == '!!null' || "$1" == 'null' ]]; }
#}}}

# identify the yq implementation (idempotent; never exits / DESIGN 7.2)
# only called when a query failed, or by the test subcommand
_yq_detect() { #{{{
  [[ -n "$_YQ_IMPL" ]] && return 0
  local OUT FIRST SECOND
  # the exit code is not checked: kislyuk/yq reports its version even without jq
  OUT=$(yq --version 2>&1)
  FIRST=${OUT%%$'\n'*}
  SECOND=${OUT#*$'\n'}
  [[ "$SECOND" == "$FIRST" ]] && SECOND=
  if [[ "$OUT" == *mikefarah* ]]; then
    _YQ_IMPL=go
    _YQ_VERSION="mikefarah/yq ${FIRST##* }"
  elif [[ "$FIRST" =~ ^yq[[:space:]]+[0-9] ]]; then
    _YQ_IMPL=python
    _YQ_VERSION="kislyuk/yq ${FIRST##* }"
    [[ -n "$SECOND" ]] && _YQ_VERSION="${_YQ_VERSION} ($(_sanitize "$SECOND"))"
  else
    _YQ_IMPL=unknown
    _YQ_VERSION=$(_sanitize "$FIRST")
  fi
  return 0
}
#}}}

# explain why a yq query failed, when the reason is the yq implementation itself
# returns 0 when yq looks usable, so the caller can report the parse error instead
_yq_diagnose() { #{{{
  _yq_detect
  case "$_YQ_IMPL" in
    python)
      command -v jq >/dev/null 2>&1 \
        || _error_exit "$_EXIT_DEPS" "$(_err_no_command jq)"
      ;;
    unknown)
      _error_exit "$_EXIT_DEPS" "$(_err_unsupported_yq "$_YQ_VERSION")"
      ;;
  esac
  return 0
}
#}}}

# default path of the user config file (SPECS 4.1)
_config_user_path() { #{{{
  if [[ -n "$XDG_CONFIG_HOME" ]]; then
    printf '%s\n' "${XDG_CONFIG_HOME}/port-forwarder/config.yaml"
  else
    printf '%s\n' "${HOME}/.config/port-forwarder/config.yaml"
  fi
}
#}}}

# determine which config file to use (SPECS 4.1)
_config_find() { #{{{
  local P
  if [[ -n "$_OPT_CONFIG" ]]; then
    P=$(_expand_tilde "$_OPT_CONFIG")
    [[ -f "$P" ]] || _error_exit "$_EXIT_CONFIG" "$(_err_no_config "$P")"
    _CONFIG_FILE=$P
    return 0
  fi
  local CANDIDATES=()
  CANDIDATES+=("$(_config_user_path)")
  CANDIDATES+=("$_SYSTEM_CONFIG")
  for P in "${CANDIDATES[@]}"; do
    if [[ -f "$P" ]]; then
      _CONFIG_FILE=$P
      return 0
    fi
  done
  _error_exit "$_EXIT_CONFIG" "$(_err_no_config "${CANDIDATES[0]}")"
}
#}}}

# list the main config plus conf.d/*.yaml|yml sorted by name (SPECS 4.1)
_config_file_list() { #{{{
  local DIR CONFD F
  _CONFIG_FILES=("$_CONFIG_FILE")
  DIR=$(dirname "$_CONFIG_FILE")
  CONFD="${DIR}/conf.d"
  [[ -d "$CONFD" ]] || return 0
  local LIST=() SORTED=()
  shopt -s nullglob
  LIST=("$CONFD"/*.yaml "$CONFD"/*.yml)
  shopt -u nullglob
  (( ${#LIST[@]} == 0 )) && return 0
  mapfile -t SORTED < <(printf '%s\n' "${LIST[@]}" | LC_ALL=C sort)
  for F in "${SORTED[@]}"; do
    [[ -f "$F" ]] && _CONFIG_FILES+=("$F")
  done
  return 0
}
#}}}

# drop all existing keys of an entry (replacement is per entry / DESIGN 4.1)
_config_purge_entry() { #{{{
  local NAME=$1 K
  for K in "${!_CFG[@]}"; do
    [[ "$K" == "${NAME}."* ]] && unset "_CFG[$K]"
  done
  unset "_CFG_OPTS[$NAME]"
  unset "_CFG_INVALID[$NAME]"
  return 0
}
#}}}

# disable an entry (only that entry becomes invalid / SPECS 4.4)
_config_invalidate() { #{{{
  local NAME=$1
  shift
  _CFG_INVALID[$NAME]=$*
  return 0
}
#}}}

_is_port() { #{{{
  local V=$1
  [[ "$V" =~ ^[0-9]+$ ]] || return 1
  (( V >= 1 && V <= 65535 )) || return 1
  return 0
}
#}}}

# get permissions in octal from the first column of ls -ln (avoids stat's OS differences)
_file_mode_octal() { #{{{
  local F=$1 LINE M I DIGIT RES=
  # parse ls -ln to avoid the option differences of stat (GNU / BSD) (DESIGN 4.3)
  # shellcheck disable=SC2012
  LINE=$(ls -ln "$F" 2>/dev/null | head -1)
  [[ -z "$LINE" ]] && return 1
  M=${LINE%% *}
  M=${M:1:9}
  (( ${#M} < 9 )) && return 1
  for I in 0 3 6; do
    DIGIT=0
    [[ "${M:$I:1}" == 'r' ]] && DIGIT=$(( DIGIT + 4 ))
    [[ "${M:$(( I + 1 )):1}" == 'w' ]] && DIGIT=$(( DIGIT + 2 ))
    [[ "${M:$(( I + 2 )):1}" =~ ^[xsSt]$ ]] && DIGIT=$(( DIGIT + 1 ))
    RES="${RES}${DIGIT}"
  done
  printf '0%s\n' "$RES"
  return 0
}
#}}}

# load a single config file (yq queries 0-4 of DESIGN 4.1)
_config_parse_file() { #{{{
  local FILE=$1
  local TAG NAME KEY VAL OPT LINE SEPS RC LAST_NAME LAST_KEY

  # shellcheck disable=SC2119
  [[ -z "$_YQ_ERR_FILE" ]] && _YQ_ERR_FILE=$(__make_tmp)

  # 0. structure validation
  TAG=$(yq -r '.entries | type' "$FILE" 2>"$_YQ_ERR_FILE")
  RC=$?
  if (( RC != 0 )); then
    # exits when yq itself is the problem (unknown implementation / missing jq)
    _yq_diagnose
    _error_exit "$_EXIT_CONFIG" "$(_err_parse_failed "$FILE" "$(_sanitize "$(cat "$_YQ_ERR_FILE")")")"
  fi
  if ! _yq_is_map "$TAG" && ! _yq_is_null "$TAG"; then
    _error_exit "$_EXIT_CONFIG" "$(_err_parse_failed "$FILE" "'entries' must be a map (got $(_yq_kind "$TAG"))")"
  fi

  # 1. entry names (in order of appearance) and value types
  while IFS=$_US read -r NAME TAG; do
    [[ -z "$NAME" ]] && continue
    if [[ -n "${_CFG_SOURCE[$NAME]}" ]]; then
      _config_purge_entry "$NAME"
    else
      _CFG_NAMES+=("$NAME")
    fi
    _CFG_SOURCE[$NAME]=$FILE
    if ! _yq_is_map "$TAG"; then
      _config_invalidate "$NAME" "entry must be a map (got $(_yq_kind "$TAG"))"
    fi
  done < <(yq -r "(.entries // {}) | to_entries | .[]
                 | [.key, (.value | type)] | join(\"${_US}\")" "$FILE" 2>/dev/null)

  # 2. global (last one wins, per key)
  while IFS=$_US read -r KEY VAL; do
    [[ -z "$KEY" ]] && continue
    _GLOBAL[$KEY]=$VAL
  done < <(yq -r "(.global // {}) | to_entries | .[]
                 | select((.value | type) != ([] | type) and (.value | type) != ({} | type))
                 | [.key, .value] | join(\"${_US}\")" "$FILE" 2>/dev/null)

  # 3. scalar values of an entry (the columns shift only on 0x1f / newline in a value)
  LAST_NAME=
  LAST_KEY=
  while IFS= read -r LINE; do
    [[ -z "$LINE" ]] && continue
    SEPS=${LINE//[^$_US]/}
    if (( ${#SEPS} < 2 )); then
      # a continuation line: the value of the previous key spans several lines
      [[ -n "$LAST_NAME" ]] && _config_invalidate "$LAST_NAME" "value of '${LAST_KEY}' contains a newline"
      continue
    fi
    IFS=$_US read -r NAME KEY VAL <<<"$LINE"
    if (( ${#SEPS} > 2 )); then
      # the value itself holds the delimiter, so the columns cannot be trusted
      _config_invalidate "$NAME" "value of '${KEY}' contains a 0x1f character"
      LAST_NAME=
      LAST_KEY=
      continue
    fi
    [[ -z "$NAME" || -z "$KEY" ]] && continue
    _CFG[${NAME}.${KEY}]=$VAL
    LAST_NAME=$NAME
    LAST_KEY=$KEY
  done < <(yq -r "(.entries // {}) | to_entries | .[]
                 | select((.value | type) == ({} | type))
                 | .key as \$n | .value | to_entries | .[]
                 | select((.value | type) != ([] | type) and (.value | type) != ({} | type))
                 | [\$n, .key, .value] | join(\"${_US}\")" "$FILE" 2>/dev/null)

  # 4. ssh_options (an array)
  while IFS=$_US read -r NAME OPT; do
    [[ -z "$NAME" ]] && continue
    if [[ "$OPT" == *"$_US"* ]]; then
      _config_invalidate "$NAME" "ssh_options must not contain a 0x1f character"
      continue
    fi
    if [[ -n "${_CFG_OPTS[$NAME]}" ]]; then
      _CFG_OPTS[$NAME]="${_CFG_OPTS[$NAME]}${_US}${OPT}"
    else
      _CFG_OPTS[$NAME]=$OPT
    fi
  done < <(yq -r "(.entries // {}) | to_entries | .[]
                 | select((.value | type) == ({} | type))
                 | select(((.value.ssh_options // []) | type) == ([] | type))
                 | select(((.value.ssh_options // []) | length) > 0)
                 | .key as \$n | (.value.ssh_options // []) | .[]
                 | [\$n, .] | join(\"${_US}\")" "$FILE" 2>/dev/null)

  return 0
}
#}}}

# fill in the default values (SPECS 4.3 / DESIGN 4.2)
_config_apply_defaults() { #{{{
  local NAME KEY V
  local -A GDEF=(
    [check_interval]=30
    [connect_timeout]=10
    [retry_initial]=5
    [retry_max]=300
    [retry_limit]=0
    [server_alive_interval]=15
    [server_alive_count_max]=3
  )
  for KEY in "${!GDEF[@]}"; do
    [[ -z "${_GLOBAL[$KEY]}" ]] && _GLOBAL[$KEY]=${GDEF[$KEY]}
  done
  [[ -z "${_GLOBAL[log_file]}" ]] && _GLOBAL[log_file]=

  if [[ "${_GLOBAL[check_interval]}" =~ ^[0-9]+$ ]] && (( _GLOBAL[check_interval] < _MIN_CHECK_INTERVAL )); then
    __show_warn "global.check_interval ${_GLOBAL[check_interval]} is below the minimum ${_MIN_CHECK_INTERVAL}; using ${_MIN_CHECK_INTERVAL}"
    _GLOBAL[check_interval]=$_MIN_CHECK_INTERVAL
  fi

  for NAME in "${_CFG_NAMES[@]}"; do
    [[ -z "${_CFG[${NAME}.user]}" ]]           && _CFG[${NAME}.user]=${USER:-}
    [[ -z "${_CFG[${NAME}.port]}" ]]           && _CFG[${NAME}.port]=22
    [[ -z "${_CFG[${NAME}.remote_host]}" ]]    && _CFG[${NAME}.remote_host]=localhost
    [[ -z "${_CFG[${NAME}.bind_address]}" ]]   && _CFG[${NAME}.bind_address]=127.0.0.1
    [[ -z "${_CFG[${NAME}.enabled]}" ]]        && _CFG[${NAME}.enabled]=true
    [[ -z "${_CFG[${NAME}.check_mode]}" ]]     && _CFG[${NAME}.check_mode]=remote
    if [[ -z "${_CFG[${NAME}.check_interval]}" ]]; then
      _CFG[${NAME}.check_interval]=${_GLOBAL[check_interval]}
    elif [[ "${_CFG[${NAME}.check_interval]}" =~ ^[0-9]+$ ]] && (( _CFG[${NAME}.check_interval] < _MIN_CHECK_INTERVAL )); then
      __show_warn "[${NAME}] check_interval ${_CFG[${NAME}.check_interval]} is below the minimum ${_MIN_CHECK_INTERVAL}; using ${_MIN_CHECK_INTERVAL}"
      _CFG[${NAME}.check_interval]=$_MIN_CHECK_INTERVAL
    fi
    V=${_CFG[${NAME}.identity]}
    [[ -n "$V" ]] && _CFG[${NAME}.identity]=$(_expand_tilde "$V")
  done
  return 0
}
#}}}

# normalize boolean notations to true / false
_normalize_bool() { #{{{
  local V=$1
  case "${V,,}" in
    true|yes|1|on)   printf 'true\n';  return 0 ;;
    false|no|0|off)  printf 'false\n'; return 0 ;;
  esac
  printf '%s\n' "$V"
  return 1
}
#}}}

# validate the configuration (SPECS 4.4 / DESIGN 4.3)
_config_validate() { #{{{
  local NAME KEY V SUF OTHER PKEY MODE
  local -A SEEN_PORT=()

  for NAME in "${_CFG_NAMES[@]}"; do
    [[ -n "${_CFG_INVALID[$NAME]}" ]] && continue

    if [[ ! "$NAME" =~ ^[A-Za-z0-9._-]{1,32}$ ]]; then
      _config_invalidate "$NAME" "invalid entry name (must match [A-Za-z0-9._-]{1,32})"
      continue
    fi

    # required keys
    local BAD=
    for KEY in host local_port remote_port; do
      if [[ -z "${_CFG[${NAME}.${KEY}]}" ]]; then
        _config_invalidate "$NAME" "$(_err_missing_key "$NAME" "$KEY")"
        BAD=yes
        break
      fi
    done
    [[ -n "$BAD" ]] && continue

    # port range
    for KEY in local_port remote_port port; do
      V=${_CFG[${NAME}.${KEY}]}
      if ! _is_port "$V"; then
        _config_invalidate "$NAME" "$(_err_bad_port "$NAME" "$KEY" "$V")"
        BAD=yes
        break
      fi
    done
    [[ -n "$BAD" ]] && continue

    # duplicate local_port (disable both entries on a duplicate)
    PKEY="${_CFG[${NAME}.bind_address]}:${_CFG[${NAME}.local_port]}"
    if [[ -n "${SEEN_PORT[$PKEY]}" ]]; then
      OTHER=${SEEN_PORT[$PKEY]}
      V=$(_err_dup_port "${_CFG[${NAME}.local_port]}" "$OTHER" "$NAME")
      _config_invalidate "$NAME" "$V"
      _config_invalidate "$OTHER" "$V"
      continue
    fi
    SEEN_PORT[$PKEY]=$NAME

    # existence and permissions of identity
    V=${_CFG[${NAME}.identity]}
    if [[ -n "$V" ]]; then
      if [[ ! -f "$V" ]]; then
        _config_invalidate "$NAME" "$(_err_no_identity "$NAME" "$V")"
        continue
      fi
      local MODE
      MODE=$(_file_mode_octal "$V")
      if [[ -n "$MODE" && "${MODE:2:2}" != '00' ]]; then
        _config_invalidate "$NAME" "$(_err_key_perm "$NAME" "$V" "$MODE")"
        continue
      fi
    fi

    # check_mode
    MODE=${_CFG[${NAME}.check_mode]}
    if [[ "$MODE" != 'process' && "$MODE" != 'tcp' && "$MODE" != 'remote' ]]; then
      _config_invalidate "$NAME" "[${NAME}] invalid check_mode '${MODE}' (must be process, tcp or remote)"
      continue
    fi

    # normalize enabled
    if ! V=$(_normalize_bool "${_CFG[${NAME}.enabled]}"); then
      _config_invalidate "$NAME" "[${NAME}] invalid enabled value '${_CFG[${NAME}.enabled]}'"
      continue
    fi
    _CFG[${NAME}.enabled]=$V

    # check_interval
    V=${_CFG[${NAME}.check_interval]}
    if [[ ! "$V" =~ ^[0-9]+$ ]]; then
      _config_invalidate "$NAME" "[${NAME}] check_interval must be an integer (got '${V}')"
      continue
    fi

    # safety of bind_address (SPECS chapter 11)
    V=${_CFG[${NAME}.bind_address]}
    if [[ "$V" == '0.0.0.0' || "$V" == '::' ]]; then
      __show_warn "[${NAME}] bind_address ${V} exposes local port ${_CFG[${NAME}.local_port]} to other hosts"
    fi

    # warn when ssh_options relaxes StrictHostKeyChecking (DESIGN 9)
    if [[ "${_CFG_OPTS[$NAME]}" == *'StrictHostKeyChecking=no'* \
       || "${_CFG_OPTS[$NAME]}" == *'StrictHostKeyChecking=accept-new'* ]]; then
      __show_warn "[${NAME}] ssh_options relaxes StrictHostKeyChecking; host keys will not be verified"
    fi

    # unknown keys (warning only)
    for KEY in "${!_CFG[@]}"; do
      [[ "$KEY" == "${NAME}."* ]] || continue
      SUF=${KEY#"${NAME}".}
      [[ "$SUF" == *.* ]] && continue
      _in_array "$SUF" "${_KNOWN_ENTRY_KEYS[@]}" && continue
      __show_warn "[${NAME}] unknown key '${SUF}' (ignored)"
    done
  done

  # unknown global keys (warning only)
  for KEY in "${!_GLOBAL[@]}"; do
    _in_array "$KEY" "${_KNOWN_GLOBAL_KEYS[@]}" && continue
    __show_warn "unknown key 'global.${KEY}' (ignored)"
  done

  # warn about invalid entries (emit only once when two entries share a cause, e.g. a duplicate port)
  if [[ -z "$_NO_CFG_WARN" ]]; then
    local -A SEEN_MSG=()
    for NAME in "${_CFG_NAMES[@]}"; do
      V=${_CFG_INVALID[$NAME]}
      [[ -z "$V" || -n "${SEEN_MSG[$V]}" ]] && continue
      SEEN_MSG[$V]=1
      __show_warn "$V"
    done
  fi
  return 0
}
#}}}

# warn when the config file is writable by other users (SPECS chapter 11)
_config_check_perms() { #{{{
  local F MODE
  for F in "${_CONFIG_FILES[@]}"; do
    MODE=$(_file_mode_octal "$F") || continue
    if [[ "${MODE:2:1}" == [2367] || "${MODE:3:1}" == [2367] ]]; then
      __show_warn "config file ${F} is writable by other users (${MODE})"
    fi
  done
  return 0
}
#}}}

# discard the loaded configuration (used by reload)
_config_reset() { #{{{
  _CFG=()
  _CFG_OPTS=()
  _GLOBAL=()
  _CFG_INVALID=()
  _CFG_SOURCE=()
  _CFG_NAMES=()
  _CONFIG_FILES=()
  return 0
}
#}}}

# locate, load and validate the configuration in one go
_config_setup() { #{{{
  _config_find
  _config_file_list
  local F
  for F in "${_CONFIG_FILES[@]}"; do
    _debug "loading config: ${F}"
    _config_parse_file "$F"
  done
  if (( ${#_CFG_NAMES[@]} == 0 )); then
    _error_exit "$_EXIT_CONFIG" "$(_err_no_entries "$_CONFIG_FILE")"
  fi
  _config_apply_defaults
  _config_validate
  _config_check_perms
  return 0
}
#}}}

# generate a config file template (SPECS 4.5)
_config_init() { #{{{
  local PATH_=$1 FORCE=$2 DIR
  # checked before --force so that 'cat > <dir>' can never be reached
  [[ -d "$PATH_" ]] && _error_exit "$_EXIT_ERROR" "$(_err_config_is_dir "$PATH_")"
  if [[ -e "$PATH_" && -z "$FORCE" ]]; then
    _error_exit "$_EXIT_ERROR" "config file already exists: ${PATH_}. Use --force to overwrite it."
  fi
  DIR=$(dirname "$PATH_")
  if [[ ! -d "$DIR" ]] && ! mkdir -p "$DIR" 2>/dev/null; then
    _error_exit "$_EXIT_ERROR" "$(_err_config_mkdir "$DIR")"
  fi
  # 2>/dev/null must come BEFORE > "$PATH_", or bash's own redirection error leaks
  if ! cat 2>/dev/null > "$PATH_" <<'PFWD_CONFIG_TEMPLATE'
# port-forwarder configuration
#
# See 'pfwd help config' and SPECS.md for the full reference.

# global settings (optional; the defaults are used when omitted)
global:
  check_interval: 30          # health check interval (sec); minimum 5
  connect_timeout: 10         # SSH connect timeout (sec)
  retry_initial: 5            # initial reconnect wait (sec)
  retry_max: 300              # upper bound of the reconnect wait (sec)
  retry_limit: 0              # max consecutive failures; 0 means unlimited
  server_alive_interval: 15   # SSH keepalive interval (sec)
  server_alive_count_max: 3   # allowed number of missed keepalives
  # log_file: ~/.local/state/port-forwarder/port-forwarder.log  # stdout when unset

# entry definitions; the key is the unique entry name ([A-Za-z0-9._-]{1,32})
entries:
  example:
    description: example tunnel     # optional: description shown in listings
    host: bastion.example.com       # required: SSH destination host
    # user: your-name               # optional: defaults to $USER
    # port: 22                      # optional: SSH port; default 22
    # identity: ~/.ssh/id_ed25519   # optional: private key
    local_port: 18080               # required: local listening port
    remote_host: localhost          # optional: target seen from the bastion; default localhost
    remote_port: 80                 # required: destination port
    # bind_address: 127.0.0.1       # optional: default 127.0.0.1
    enabled: false                  # optional: default true
    check_mode: remote              # optional: process | tcp | remote; default remote
    # ssh_options:                  # optional: extra ssh -o settings
    #   - Compression=yes
PFWD_CONFIG_TEMPLATE
  then
    _error_exit "$_EXIT_ERROR" "$(_err_config_not_writable "$PATH_")"
  fi
  chmod 600 "$PATH_" 2>/dev/null
  printf 'Created: %s\n' "$PATH_"
  printf "Edit the file and run '%s test' to validate.\n" "$__SCRIPT_NAME"
  # a path outside the search order of _config_find needs -c on every run
  if [[ "$PATH_" != "$(_config_user_path)" && "$PATH_" != "$_SYSTEM_CONFIG" ]]; then
    printf "Note: this path is not searched automatically. Run '%s --config %s <subcommand>'.\n" \
      "$__SCRIPT_NAME" "$PATH_"
  fi
  return 0
}
#}}}
#}}}

#-------------------------------------------------------------------------------
#- state functions -------------------------------------------------------------
#{{{
# keys written to the state file (DESIGN 4.4)
_STATE_KEYS=(status pid ctl since connected_since retry_count backoff \
             next_retry_at next_check_at conn_sig last_error)

# determine the runtime directory (DESIGN 3.3)
_setup_runtime_dir() { #{{{
  if (( EUID == 0 )) && [[ "$_CONFIG_FILE" == "${_SYSTEM_CONFIG_DIR}/"* ]]; then
    if [[ "$(uname)" == 'Darwin' ]]; then
      _RUN_DIR='/usr/local/var/run/port-forwarder'
    else
      _RUN_DIR='/run/port-forwarder'
    fi
  elif [[ -n "$XDG_RUNTIME_DIR" ]]; then
    _RUN_DIR="${XDG_RUNTIME_DIR}/port-forwarder"
  else
    _RUN_DIR="${HOME}/.local/state/port-forwarder/run"
  fi
  _state_init
}
#}}}

# create the runtime directory (permissions follow umask 077)
_state_init() { #{{{
  local D
  for D in "$_RUN_DIR" "${_RUN_DIR}/state" "${_RUN_DIR}/ctl" "${_RUN_DIR}/err"; do
    [[ -d "$D" ]] && continue
    mkdir -p "$D" 2>/dev/null || _error_exit "$_EXIT_ERROR" "cannot create runtime directory: ${D}"
  done
  chmod 700 "$_RUN_DIR" 2>/dev/null
  return 0
}
#}}}

# load the state file; initialize it with defaults when it does not exist
_state_load() { #{{{
  local NAME=$1 F K V
  F="${_RUN_DIR}/state/${NAME}.state"
  _ST[${NAME}.status]=stopped
  _ST[${NAME}.pid]=0
  _ST[${NAME}.ctl]=
  _ST[${NAME}.since]=0
  _ST[${NAME}.connected_since]=0
  _ST[${NAME}.retry_count]=0
  _ST[${NAME}.backoff]=0
  _ST[${NAME}.next_retry_at]=0
  _ST[${NAME}.next_check_at]=0
  _ST[${NAME}.conn_sig]=
  _ST[${NAME}.last_error]=
  [[ -f "$F" ]] || return 1
  # parse the state file by hand instead of sourcing it (DESIGN 9)
  while IFS='=' read -r K V; do
    [[ -z "$K" ]] && continue
    _in_array "$K" "${_STATE_KEYS[@]}" || continue
    _ST[${NAME}.${K}]=$V
  done < "$F"
  return 0
}
#}}}

_state_load_all() { #{{{
  local NAME
  for NAME in "${_CFG_NAMES[@]}"; do
    _state_load "$NAME"
  done
  return 0
}
#}}}

# write the contents of _ST to the state file atomically (called by the daemon only)
_state_flush() { #{{{
  local NAME=$1 F TMP K
  F="${_RUN_DIR}/state/${NAME}.state"
  TMP="${_RUN_DIR}/err/${NAME}.state.tmp"
  {
    for K in "${_STATE_KEYS[@]}"; do
      printf '%s=%s\n' "$K" "${_ST[${NAME}.${K}]}"
    done
  } > "$TMP" 2>/dev/null || return 1
  mv -f "$TMP" "$F" 2>/dev/null || return 1
  unset "_ST_DIRTY[$NAME]"
  return 0
}
#}}}

# write only the entries that changed
_state_flush_dirty() { #{{{
  local NAME
  for NAME in "${!_ST_DIRTY[@]}"; do
    _state_flush "$NAME"
  done
  return 0
}
#}}}

_state_set() { #{{{
  local NAME=$1 KEY=$2 VAL=$3
  _ST[${NAME}.${KEY}]=$VAL
  _ST_DIRTY[$NAME]=1
  return 0
}
#}}}

_state_get() { #{{{
  printf '%s\n' "${_ST[${1}.${2}]}"
}
#}}}

# every state transition goes through this function (for log consistency / DESIGN 5.4)
_state_transit() { #{{{
  local NAME=$1 NEW=$2 REASON=$3 OLD
  OLD=${_ST[${NAME}.status]}
  _ST[${NAME}.status]=$NEW
  _ST[${NAME}.since]=$(_now)
  _ST_DIRTY[$NAME]=1
  [[ "$OLD" == "$NEW" ]] && return 0
  if [[ -n "$REASON" ]]; then
    _log_info "$NAME" "state: ${OLD} -> ${NEW} (${REASON})"
  else
    _log_info "$NAME" "state: ${OLD} -> ${NEW}"
  fi
  return 0
}
#}}}

# remove state / desired / err when an entry is deleted
_state_remove() { #{{{
  local NAME=$1 K
  rm -f "${_RUN_DIR}/state/${NAME}.state" \
        "${_RUN_DIR}/state/${NAME}.desired" \
        "${_RUN_DIR}/err/${NAME}.err" 2>/dev/null
  for K in "${!_ST[@]}"; do
    [[ "$K" == "${NAME}."* ]] && unset "_ST[$K]"
  done
  unset "_ST_DIRTY[$NAME]"
  return 0
}
#}}}

# write the desired state (only the CLI writes it / DESIGN 4.5)
_desired_set() { #{{{
  local NAME=$1 VAL=$2 F TMP
  F="${_RUN_DIR}/state/${NAME}.desired"
  TMP="${_RUN_DIR}/err/${NAME}.desired.tmp"
  printf '%s\n' "$VAL" > "$TMP" 2>/dev/null || return 1
  mv -f "$TMP" "$F" 2>/dev/null || return 1
  return 0
}
#}}}

# read the desired state; when the file does not exist, enabled is the initial value
_desired_get() { #{{{
  local NAME=$1 F V
  F="${_RUN_DIR}/state/${NAME}.desired"
  if [[ -f "$F" ]]; then
    read -r V < "$F"
    case "$V" in
      up|down) printf '%s\n' "$V"; return 0 ;;
    esac
  fi
  if [[ "${_CFG[${NAME}.enabled]}" == 'false' ]]; then
    printf 'down\n'
  else
    printf 'up\n'
  fi
  return 0
}
#}}}

_desired_remove() { #{{{
  rm -f "${_RUN_DIR}/state/${1}.desired" 2>/dev/null
  return 0
}
#}}}
#}}}

#-------------------------------------------------------------------------------
#- ssh session functions -------------------------------------------------------
#{{{
# determine the ControlPath (DESIGN 3.3)
_ctl_path() { #{{{
  local NAME=$1 P BASE SUM
  P="${_RUN_DIR}/ctl/${NAME}.sock"
  if (( ${#P} > _CTL_PATH_MAX )); then
    # it would exceed the UNIX domain socket path length limit (macOS 104 / Linux 108),
    # so fall back to a short path under TMPDIR
    BASE="${TMPDIR:-/tmp}/pfwd-${EUID}"
    mkdir -p "$BASE" 2>/dev/null
    chmod 700 "$BASE" 2>/dev/null
    SUM=$(printf '%s' "$NAME" | cksum | awk '{print $1}')
    P="${BASE}/${SUM}.sock"
  fi
  (( ${#P} > _CTL_PATH_MAX )) && return 1
  printf '%s\n' "$P"
  return 0
}
#}}}

# signature of the connection parameters (DESIGN 4.6)
_conn_sig() { #{{{
  local NAME=$1
  printf '%s\n' "${_CFG[${NAME}.host]}${_US}${_CFG[${NAME}.user]}${_US}${_CFG[${NAME}.port]}${_US}${_CFG[${NAME}.identity]}${_US}${_CFG[${NAME}.local_port]}${_US}${_CFG[${NAME}.remote_host]}${_US}${_CFG[${NAME}.remote_port]}${_US}${_CFG[${NAME}.bind_address]}${_US}${_CFG_OPTS[$NAME]}"
}
#}}}

# expand the ssh_options of an entry into an array
_entry_ssh_options() { #{{{
  local NAME=$1
  _ENTRY_OPTS=()
  [[ -z "${_CFG_OPTS[$NAME]}" ]] && return 0
  IFS=$_US read -r -a _ENTRY_OPTS <<<"${_CFG_OPTS[$NAME]}"
  return 0
}
#}}}

# build the ssh invocation arguments into _SSH_ARGS (DESIGN 5.5)
_ssh_build_args() { #{{{
  local NAME=$1 CTL=$2 OPT
  _entry_ssh_options "$NAME"
  _SSH_ARGS=(ssh -N -T -M -S "$CTL"
    -o ControlMaster=yes
    -o ControlPersist=no
    -o ExitOnForwardFailure=yes
    -o BatchMode=yes
    -o NumberOfPasswordPrompts=0
    -o StrictHostKeyChecking=yes
    -o ConnectTimeout="${_GLOBAL[connect_timeout]}"
    -o ServerAliveInterval="${_GLOBAL[server_alive_interval]}"
    -o ServerAliveCountMax="${_GLOBAL[server_alive_count_max]}"
    -p "${_CFG[${NAME}.port]}"
    -L "${_CFG[${NAME}.bind_address]}:${_CFG[${NAME}.local_port]}:${_CFG[${NAME}.remote_host]}:${_CFG[${NAME}.remote_port]}")
  [[ -n "${_CFG[${NAME}.identity]}" ]] && _SSH_ARGS+=(-o IdentitiesOnly=yes -i "${_CFG[${NAME}.identity]}")
  [[ -n "${_CFG[${NAME}.user]}" ]] && _SSH_ARGS+=(-l "${_CFG[${NAME}.user]}")
  # user-specified ssh_options come after the defaults so that they win and can override them
  for OPT in "${_ENTRY_OPTS[@]}"; do
    _SSH_ARGS+=(-o "$OPT")
  done
  _SSH_ARGS+=("${_CFG[${NAME}.host]}")
  return 0
}
#}}}

# start ssh in the background; do not wait for the connection to be established (DESIGN 5.5)
_ssh_start() { #{{{
  local NAME=$1 CTL ERRF PID
  if ! CTL=$(_ctl_path "$NAME"); then
    _state_set "$NAME" last_error "ControlPath for '${NAME}' exceeds the socket path limit"
    _log_error "$NAME" "ControlPath exceeds the socket path limit; cannot start"
    _state_transit "$NAME" failed 'ControlPath too long'
    return 1
  fi
  rm -f "$CTL" 2>/dev/null
  ERRF="${_RUN_DIR}/err/${NAME}.err"
  : > "$ERRF" 2>/dev/null
  _ssh_build_args "$NAME" "$CTL"
  _debug2 "[${NAME}] exec: ${_SSH_ARGS[*]}"
  "${_SSH_ARGS[@]}" </dev/null >>"$ERRF" 2>&1 &
  PID=$!
  _state_set "$NAME" pid "$PID"
  _state_set "$NAME" ctl "$CTL"
  _state_set "$NAME" conn_sig "$(_conn_sig "$NAME")"
  _state_set "$NAME" last_error ''
  _state_transit "$NAME" connecting
  _log_info "$NAME" "starting ssh (pid=${PID}, ${_CFG[${NAME}.bind_address]}:${_CFG[${NAME}.local_port]} -> ${_CFG[${NAME}.remote_host]}:${_CFG[${NAME}.remote_port]})"
  return 0
}
#}}}

# whether the session is alive (prefers ControlMaster, falls back to the PID)
_ssh_is_alive() { #{{{
  local NAME=$1 CTL PID
  CTL=${_ST[${NAME}.ctl]}
  PID=${_ST[${NAME}.pid]}
  if [[ -n "$CTL" && -S "$CTL" ]]; then
    ssh -O check -S "$CTL" -o BatchMode=yes "${_CFG[${NAME}.host]}" >/dev/null 2>&1
    return $?
  fi
  [[ -n "$PID" && "$PID" != '0' ]] || return 1
  kill -0 "$PID" 2>/dev/null
}
#}}}

# terminate the session reliably (DESIGN 5.5)
_ssh_stop() { #{{{
  local NAME=$1 CTL PID I
  CTL=${_ST[${NAME}.ctl]}
  PID=${_ST[${NAME}.pid]}

  # 1. terminate via ControlMaster
  if [[ -n "$CTL" && -S "$CTL" ]]; then
    ssh -O exit -S "$CTL" -o BatchMode=yes "${_CFG[${NAME}.host]}" >/dev/null 2>&1
    for (( I = 0; I < 20; I++ )); do
      _ssh_pid_alive "$PID" || break
      sleep 0.1
    done
  fi

  # 2. SIGTERM
  if _ssh_pid_alive "$PID"; then
    kill -TERM "$PID" 2>/dev/null
    for (( I = 0; I < 30; I++ )); do
      _ssh_pid_alive "$PID" || break
      sleep 0.1
    done
  fi

  # 3. SIGKILL
  if _ssh_pid_alive "$PID"; then
    _log_warn "$NAME" "ssh (pid=${PID}) did not exit; sending SIGKILL"
    kill -KILL "$PID" 2>/dev/null
    sleep 0.1
  fi

  # 4. clean up the socket
  [[ -n "$CTL" ]] && rm -f "$CTL" 2>/dev/null

  # 5. drop the PID
  _state_set "$NAME" pid 0
  return 0
}
#}}}

_ssh_pid_alive() { #{{{
  local PID=$1
  [[ -n "$PID" && "$PID" != '0' ]] || return 1
  kill -0 "$PID" 2>/dev/null
}
#}}}

# take the most recent meaningful line from ssh's stderr and truncate the file
_ssh_take_error() { #{{{
  local NAME=$1 F LINE MSG=
  F="${_RUN_DIR}/err/${NAME}.err"
  if [[ -f "$F" ]]; then
    while IFS= read -r LINE; do
      [[ -z "$LINE" ]] && continue
      [[ "$LINE" == 'Warning: Permanently added'* ]] && continue
      MSG=$LINE
    done < "$F"
    : > "$F" 2>/dev/null
  fi
  _sanitize "$MSG"
  return 0
}
#}}}

# classify why ssh failed (DESIGN 7.4); fatal means retrying can never succeed
_ssh_classify_error() { #{{{
  local MSG=$1
  case "$MSG" in
    *'Host key verification failed'*|*'host key is not known'*|*'HOST IDENTIFICATION HAS CHANGED'*)
      printf 'fatal\n' ;;
    *'Permission denied (publickey'*|*'Permission denied ('*)
      printf 'fatal\n' ;;
    *passphrase*|*Passphrase*)
      printf 'fatal\n' ;;
    *'Address already in use'*|*'cannot listen to port'*|*'bind: '*)
      printf 'fatal\n' ;;
    *)
      printf 'retry\n' ;;
  esac
}
#}}}

# extra guidance for each failure reason (SPECS 9.2 / chapter 10)
_ssh_error_hint() { #{{{
  local NAME=$1 MSG=$2
  case "$MSG" in
    *passphrase*|*Passphrase*)
      printf 'passphrase-protected key requires ssh-agent\n' ;;
    *'Host key verification failed'*|*'host key is not known'*)
      _err_unknown_host_key "$NAME" "${_CFG[${NAME}.host]}" ;;
    *'Address already in use'*|*'cannot listen to port'*)
      _err_port_in_use "$NAME" "${_CFG[${NAME}.local_port]}" ;;
    *)
      printf '\n' ;;
  esac
}
#}}}
#}}}

#-------------------------------------------------------------------------------
#- health check functions ------------------------------------------------------
#{{{
# determine which TCP probe method is available (DESIGN 5.6)
_probe_detect() { #{{{
  local OUT
  OUT=$( { exec 3<>'/dev/tcp/127.0.0.1/1'; } 2>&1 )
  if [[ "$OUT" != *'No such file or directory'* ]]; then
    _PROBE_BACKEND=devtcp
  elif command -v nc >/dev/null 2>&1; then
    _PROBE_BACKEND=nc
    _log_warn - "bash /dev/tcp is not available; check_mode 'remote' is degraded to 'tcp'"
  else
    _PROBE_BACKEND=none
    _log_warn - "neither /dev/tcp nor nc is available; check_mode is degraded to 'process'"
  fi
  _debug "probe backend: ${_PROBE_BACKEND}"
  return 0
}
#}}}

# test only whether a TCP connection can be made (0=connectable / 1=not connectable / 2=unknown)
_probe_tcp() { #{{{
  local ADDR=$1 PORT=$2
  [[ -z "$_PROBE_BACKEND" ]] && _probe_detect
  case "$_PROBE_BACKEND" in
    devtcp)
      # group the commands and apply 2> there to swallow the redirection error of exec
      # (attaching 2>/dev/null directly to exec would replace the shell's own stderr)
      { exec 3<>"/dev/tcp/${ADDR}/${PORT}"; } 2>/dev/null || return 1
      exec 3<&- 3>&-
      return 0 ;;
    nc)
      nc -z -w "$_CHECK_TIMEOUT" "$ADDR" "$PORT" >/dev/null 2>&1 || return 1
      return 0 ;;
    *)
      return 2 ;;
  esac
}
#}}}

# determine whether the forward really works (0=works / 1=closed at once / 2=not connectable)
# a local forward closes the connection at once when it cannot open a channel to the target.
_probe_forward() { #{{{
  local ADDR=$1 PORT=$2 RC DUMMY
  { exec 3<>"/dev/tcp/${ADDR}/${PORT}"; } 2>/dev/null || return 2
  # the received content is unused (reachability check only)
  # shellcheck disable=SC2034
  read -r -t "$_REMOTE_PROBE_WAIT" -N 1 -u 3 DUMMY
  RC=$?
  exec 3<&- 3>&-
  (( RC == 0 ))  && return 0    # data received = the target is reachable
  (( RC > 128 )) && return 0    # read timeout = the connection is kept alive
  return 1                      # EOF = the target was unreachable and it was closed
}
#}}}

# whether the local port is free (0=free / 1=in use)
_is_port_free() { #{{{
  local ADDR=$1 PORT=$2
  _probe_tcp "$ADDR" "$PORT"
  case $? in
    0) return 1 ;;   # connected = in use
    1) return 0 ;;   # not connectable = free
    *) return 0 ;;   # treat unknown as free
  esac
}
#}}}

# health check according to check_mode (0=healthy / 1=unhealthy)
_health_check() { #{{{
  local NAME=$1 MODE ADDR PORT RC
  MODE=${_CFG[${NAME}.check_mode]}
  ADDR=${_CFG[${NAME}.bind_address]}
  PORT=${_CFG[${NAME}.local_port]}
  [[ "$ADDR" == '0.0.0.0' || "$ADDR" == '::' ]] && ADDR=127.0.0.1
  [[ -z "$_PROBE_BACKEND" ]] && _probe_detect

  _ssh_is_alive "$NAME" || return 1
  case "$MODE" in
    process)
      return 0 ;;
    tcp)
      _probe_tcp "$ADDR" "$PORT"
      RC=$?
      (( RC == 0 )) && return 0
      (( RC == 2 )) && return 0   # degrade to the process check when unknown
      return 1 ;;
    remote)
      if [[ "$_PROBE_BACKEND" == 'devtcp' ]]; then
        _probe_forward "$ADDR" "$PORT" && return 0
        return 1
      fi
      # degrade to the tcp check when /dev/tcp is unavailable
      _probe_tcp "$ADDR" "$PORT"
      RC=$?
      (( RC == 0 )) && return 0
      (( RC == 2 )) && return 0
      return 1 ;;
  esac
  return 0
}
#}}}
#}}}

#-------------------------------------------------------------------------------
#- daemon functions ------------------------------------------------------------
#{{{
_DAEMON_RUNNING_PID=
_CHECKS_THIS_TICK=0
_RELOAD_COUNT=0

# probe address used by the health check (hits 127.0.0.1 even when listening on 0.0.0.0)
_probe_addr() { #{{{
  local A=${_CFG[${1}.bind_address]}
  [[ "$A" == '0.0.0.0' || "$A" == '::' ]] && A=127.0.0.1
  printf '%s\n' "$A"
}
#}}}

# return the PID of the running daemon (1 when it is not alive)
_daemon_pid() { #{{{
  local F="${_RUN_DIR}/daemon.pid" PID
  [[ -f "$F" ]] || return 1
  read -r PID < "$F" 2>/dev/null
  [[ "$PID" =~ ^[0-9]+$ ]] || return 1
  kill -0 "$PID" 2>/dev/null || return 1
  printf '%s\n' "$PID"
  return 0
}
#}}}

# take a lock with the atomicity of mkdir (flock is not on macOS, so it is not used / DESIGN 5.8)
_daemon_lock_acquire() { #{{{
  local LOCK="${_RUN_DIR}/daemon.lock" PID
  _DAEMON_RUNNING_PID=
  if mkdir "$LOCK" 2>/dev/null; then
    printf '%s\n' "$$" > "${LOCK}/pid"
    return 0
  fi
  PID=$(cat "${LOCK}/pid" 2>/dev/null)
  if [[ "$PID" =~ ^[0-9]+$ ]] && kill -0 "$PID" 2>/dev/null; then
    _DAEMON_RUNNING_PID=$PID
    return 1
  fi
  _log_warn - "removing stale lock (pid=${PID:-unknown})"
  rm -rf "$LOCK" 2>/dev/null
  if mkdir "$LOCK" 2>/dev/null; then
    printf '%s\n' "$$" > "${LOCK}/pid"
    return 0
  fi
  return 1
}
#}}}

_daemon_lock_release() { #{{{
  rm -rf "${_RUN_DIR}/daemon.lock" 2>/dev/null
  return 0
}
#}}}

# record the config in use and the start time (also signals that reload finished)
_daemon_write_meta() { #{{{
  local F="${_RUN_DIR}/daemon.meta" TMP="${_RUN_DIR}/daemon.meta.tmp"
  {
    printf 'pid=%s\n' "$$"
    printf 'config=%s\n' "$_CONFIG_FILE"
    printf 'started=%s\n' "$_DAEMON_STARTED"
    printf 'updated=%s\n' "$(_now)"
    printf 'reloads=%s\n' "$_RELOAD_COUNT"
  } > "$TMP" 2>/dev/null || return 1
  mv -f "$TMP" "$F" 2>/dev/null
  return 0
}
#}}}

# signal handlers only raise a flag (DESIGN 5.7)
_on_term() { _SHUTDOWN=1; }
_on_hup()  { _FLAG_HUP=1; }
_on_usr1() { _FLAG_USR1=1; }

# re-read the state and spread out the check times (DESIGN 5.7)
_daemon_init_states() { #{{{
  local NAME NOW I=0 INTERVAL
  NOW=$(_now)
  for NAME in "${_CFG_NAMES[@]}"; do
    _state_load "$NAME"
    INTERVAL=${_CFG[${NAME}.check_interval]}
    [[ "$INTERVAL" =~ ^[0-9]+$ ]] || INTERVAL=$_MIN_CHECK_INTERVAL
    if [[ -n "${_CFG_INVALID[$NAME]}" ]]; then
      _state_set "$NAME" pid 0
      _state_set "$NAME" last_error "${_CFG_INVALID[$NAME]}"
      _state_transit "$NAME" failed 'invalid configuration'
    elif _ssh_is_alive "$NAME"; then
      # take over the sessions left behind by the previous daemon
      (( _ST[${NAME}.connected_since] == 0 )) && _state_set "$NAME" connected_since "$NOW"
      _state_transit "$NAME" connected 'adopted an existing session'
    else
      _state_set "$NAME" pid 0
      if [[ "${_CFG[${NAME}.enabled]}" == 'false' ]] \
         && [[ ! -f "${_RUN_DIR}/state/${NAME}.desired" ]]; then
        _state_transit "$NAME" disabled
      else
        _state_transit "$NAME" stopped
      fi
    fi
    _state_set "$NAME" next_check_at $(( NOW + I % INTERVAL ))
    I=$(( I + 1 ))
  done
  _state_flush_dirty
  return 0
}
#}}}

# reconcile the desired state with the current state (DESIGN 5.7)
_daemon_reconcile() { #{{{
  local NAME D S ADDR PORT
  for NAME in "${_CFG_NAMES[@]}"; do
    [[ -n "${_CFG_INVALID[$NAME]}" ]] && continue
    D=$(_desired_get "$NAME")
    S=${_ST[${NAME}.status]}
    if [[ "$D" == 'up' ]]; then
      case "$S" in
        stopped|disabled|failed)
          ADDR=$(_probe_addr "$NAME")
          PORT=${_CFG[${NAME}.local_port]}
          _state_set "$NAME" retry_count 0
          _state_set "$NAME" backoff "${_GLOBAL[retry_initial]}"
          _state_set "$NAME" next_retry_at 0
          if ! _is_port_free "$ADDR" "$PORT"; then
            _state_set "$NAME" last_error "$(_err_port_in_use "$NAME" "$PORT")"
            _log_error "$NAME" "$(_err_port_in_use "$NAME" "$PORT")"
            _state_transit "$NAME" failed 'local port already in use'
          else
            _ssh_start "$NAME"
          fi ;;
      esac
    else
      case "$S" in
        connected|connecting|retrying)
          _ssh_stop "$NAME"
          _state_transit "$NAME" stopped ;;
      esac
    fi
  done
  return 0
}
#}}}

# enter the retry state (exponential backoff / SPECS 5.3)
_enter_retrying() { #{{{
  local NAME=$1 NOW=$2 RC BO
  RC=$(( _ST[${NAME}.retry_count] + 1 ))
  if (( RC == 1 )); then
    BO=${_GLOBAL[retry_initial]}
  else
    BO=$(( _ST[${NAME}.backoff] * 2 ))
    (( BO < _GLOBAL[retry_initial] )) && BO=${_GLOBAL[retry_initial]}
    (( BO > _GLOBAL[retry_max] )) && BO=${_GLOBAL[retry_max]}
  fi
  _state_set "$NAME" retry_count "$RC"
  _state_set "$NAME" backoff "$BO"
  _state_set "$NAME" next_retry_at $(( NOW + BO ))
  _state_transit "$NAME" retrying
  _log_info "$NAME" "reconnecting in ${BO}s (attempt ${RC})"
  return 0
}
#}}}

# state transition of one entry for one cycle (DESIGN 5.7 / SPECS 5.1)
_daemon_tick_entry() { #{{{
  local NAME=$1 NOW=$2 ST ADDR PORT MSG HINT CLASS RC INTERVAL
  ST=${_ST[${NAME}.status]}
  ADDR=$(_probe_addr "$NAME")
  PORT=${_CFG[${NAME}.local_port]}
  INTERVAL=${_CFG[${NAME}.check_interval]}

  case "$ST" in
    connected)
      (( NOW < _ST[${NAME}.next_check_at] )) && return 0
      (( _CHECKS_THIS_TICK >= _MAX_CHECKS_PER_TICK )) && return 0
      _CHECKS_THIS_TICK=$(( _CHECKS_THIS_TICK + 1 ))
      if _health_check "$NAME"; then
        _state_set "$NAME" next_check_at $(( NOW + INTERVAL ))
        # reset the backoff once the session has lasted 60 seconds or more (SPECS 5.3)
        if (( NOW - _ST[${NAME}.connected_since] >= 60 )) && (( _ST[${NAME}.retry_count] > 0 )); then
          _state_set "$NAME" retry_count 0
          _state_set "$NAME" backoff "${_GLOBAL[retry_initial]}"
        fi
      else
        _log_warn "$NAME" "health check failed (${_CFG[${NAME}.check_mode]} ${ADDR}:${PORT})"
        _state_set "$NAME" last_error "health check failed (${_CFG[${NAME}.check_mode]} ${ADDR}:${PORT})"
        _ssh_stop "$NAME"
        _enter_retrying "$NAME" "$NOW"
      fi ;;

    connecting)
      if ! _ssh_is_alive "$NAME"; then
        MSG=$(_ssh_take_error "$NAME")
        [[ -z "$MSG" ]] && MSG='ssh exited unexpectedly'
        _state_set "$NAME" pid 0
        _state_set "$NAME" last_error "$MSG"
        _log_error "$NAME" "ssh exited: ${MSG}"
        HINT=$(_ssh_error_hint "$NAME" "$MSG")
        [[ -n "$HINT" ]] && _log_error "$NAME" "$HINT"
        CLASS=$(_ssh_classify_error "$MSG")
        if [[ "$CLASS" == 'fatal' ]]; then
          _state_transit "$NAME" failed "$MSG"
        else
          _enter_retrying "$NAME" "$NOW"
        fi
        return 0
      fi
      # establishment is judged with the tcp check regardless of check_mode (DESIGN 5.6)
      _probe_tcp "$ADDR" "$PORT"
      RC=$?
      if (( RC == 0 || RC == 2 )); then
        _state_transit "$NAME" connected
        _state_set "$NAME" connected_since "$NOW"
        _state_set "$NAME" next_check_at $(( NOW + INTERVAL ))
        _log_info "$NAME" "connection established (pid=${_ST[${NAME}.pid]})"
      elif (( NOW - _ST[${NAME}.since] >= _GLOBAL[connect_timeout] + 2 )); then
        _ssh_stop "$NAME"
        _state_set "$NAME" last_error "connection did not become ready within ${_GLOBAL[connect_timeout]}s"
        _log_warn "$NAME" "connection did not become ready within ${_GLOBAL[connect_timeout]}s"
        _enter_retrying "$NAME" "$NOW"
      fi ;;

    retrying)
      (( NOW < _ST[${NAME}.next_retry_at] )) && return 0
      if (( _GLOBAL[retry_limit] > 0 && _ST[${NAME}.retry_count] >= _GLOBAL[retry_limit] )); then
        _state_set "$NAME" last_error "retry limit (${_GLOBAL[retry_limit]}) reached"
        _state_transit "$NAME" failed 'retry limit reached'
        return 0
      fi
      # do not retry when the local port is used by another process (SPECS 5.3)
      if ! _is_port_free "$ADDR" "$PORT"; then
        _state_set "$NAME" last_error "$(_err_port_in_use "$NAME" "$PORT")"
        _log_error "$NAME" "$(_err_port_in_use "$NAME" "$PORT")"
        _state_transit "$NAME" failed 'local port already in use'
        return 0
      fi
      _ssh_start "$NAME" ;;

    stopped|disabled|failed)
      : ;;   # the daemon does nothing; only a desired change brings it back
  esac
  return 0
}
#}}}

# re-read the configuration and apply the differences (SPECS 5.5)
_daemon_reload() { #{{{
  local NAME SIG ADDED=0 REMOVED=0 RESTARTED=0 DISABLED=0
  local -a OLD_NAMES=("${_CFG_NAMES[@]}")

  _OPT_CONFIG=$_CONFIG_FILE
  # validate in a subshell first and keep the old config on failure (do not kill the daemon)
  if ! ( _NO_CFG_WARN=yes; _config_reset; _config_setup ) >/dev/null 2>&1; then
    _log_error - 'config reload failed; keeping the previous configuration'
    return 1
  fi
  _NO_CFG_WARN=yes
  _config_reset
  _config_setup
  _NO_CFG_WARN=

  for NAME in "${_CFG_NAMES[@]}"; do
    if ! _in_array "$NAME" "${OLD_NAMES[@]}"; then
      ADDED=$(( ADDED + 1 ))
      _state_load "$NAME"
      _state_set "$NAME" pid 0
      if [[ -n "${_CFG_INVALID[$NAME]}" ]]; then
        _state_set "$NAME" last_error "${_CFG_INVALID[$NAME]}"
        _state_transit "$NAME" failed 'invalid configuration'
      elif [[ "${_CFG[${NAME}.enabled]}" == 'false' ]]; then
        _state_transit "$NAME" disabled
      else
        _state_transit "$NAME" stopped
      fi
      continue
    fi
    if [[ -n "${_CFG_INVALID[$NAME]}" ]]; then
      _ssh_stop "$NAME"
      _state_set "$NAME" last_error "${_CFG_INVALID[$NAME]}"
      _state_transit "$NAME" failed 'invalid configuration'
      continue
    fi
    if [[ "${_CFG[${NAME}.enabled]}" == 'false' ]]; then
      if [[ "${_ST[${NAME}.status]}" != 'disabled' ]]; then
        _ssh_stop "$NAME"
        _desired_remove "$NAME"
        _state_transit "$NAME" disabled 'disabled by config'
        DISABLED=$(( DISABLED + 1 ))
      fi
      continue
    fi
    SIG=$(_conn_sig "$NAME")
    if [[ "$SIG" != "${_ST[${NAME}.conn_sig]}" ]]; then
      case "${_ST[${NAME}.status]}" in
        connected|connecting|retrying)
          _ssh_stop "$NAME"
          _state_transit "$NAME" stopped 'connection parameters changed'
          RESTARTED=$(( RESTARTED + 1 )) ;;
      esac
    fi
  done

  for NAME in "${OLD_NAMES[@]}"; do
    _in_array "$NAME" "${_CFG_NAMES[@]}" && continue
    _ssh_stop "$NAME"
    _state_remove "$NAME"
    REMOVED=$(( REMOVED + 1 ))
  done

  _log_init
  _daemon_reconcile
  _state_flush_dirty
  _RELOAD_COUNT=$(( _RELOAD_COUNT + 1 ))
  _daemon_write_meta
  _log_info - "config reloaded (added=${ADDED}, removed=${REMOVED}, restarted=${RESTARTED}, disabled=${DISABLED})"
  return 0
}
#}}}

# stop every session and exit (SPECS 5.4)
_daemon_shutdown() { #{{{
  local NAME
  _log_info - 'shutting down'
  for NAME in "${_CFG_NAMES[@]}"; do
    case "${_ST[${NAME}.status]}" in
      connected|connecting|retrying)
        _ssh_stop "$NAME"
        _state_transit "$NAME" stopped ;;
      *)
        _ssh_stop "$NAME" ;;
    esac
  done
  _state_flush_dirty
  rm -f "${_RUN_DIR}/daemon.pid" "${_RUN_DIR}/daemon.meta" 2>/dev/null
  _daemon_lock_release
  _log_info - 'daemon stopped'
  return 0
}
#}}}

# the daemon itself (DESIGN 5.7)
_daemon_main() { #{{{
  local NAME NOW
  umask 077
  if ! _daemon_lock_acquire; then
    _error_exit "$_EXIT_RUNNING" "$(_err_daemon_running "$_DAEMON_RUNNING_PID")"
  fi
  _DAEMON_STARTED=$(_now)
  printf '%s\n' "$$" > "${_RUN_DIR}/daemon.pid"
  trap '_on_term' TERM INT
  trap '_on_hup' HUP
  trap '_on_usr1' USR1

  _log_init
  _probe_detect
  _daemon_init_states
  _daemon_reconcile
  _state_flush_dirty
  _daemon_write_meta
  _log_info - "daemon started (pid=$$, entries=${#_CFG_NAMES[@]})"

  while [[ -z "$_SHUTDOWN" ]]; do
    if (( _FLAG_HUP )); then
      _FLAG_HUP=0
      _daemon_reload
    fi
    if (( _FLAG_USR1 )); then
      _FLAG_USR1=0
      _daemon_reconcile
    fi
    NOW=$(_now)
    _CHECKS_THIS_TICK=0
    for NAME in "${_CFG_NAMES[@]}"; do
      _daemon_tick_entry "$NAME" "$NOW"
    done
    _state_flush_dirty
    # reap exited ssh processes (so kill -0 does not mistake a zombie for a live one)
    jobs > /dev/null 2>&1
    sleep 1
  done

  _daemon_shutdown
  return 0
}
#}}}
#}}}

