_cmd_version() { #{{{
  printf '%s %s\n' "$__SCRIPT_NAME" "$_VERSION"
}
#}}}

_cmd_help() { #{{{
  local SUB=$1 FUNC
  if [[ -z "$SUB" ]]; then
    _show_usage
    return 0
  fi
  FUNC="_help_${SUB//-/_}"
  if declare -F "$FUNC" >/dev/null 2>&1; then
    "$FUNC"
  else
    _usage "no such subcommand: ${SUB}"
  fi
}
#}}}
