#-------------------------------------------------------------------------------
#- logging functions -----------------------------------------------------------
#{{{
# ログ出力先を決定する。書き込めない場合は標準出力にフォールバックする
_log_init() { #{{{
  local F D
  F=${_GLOBAL[log_file]}
  if [[ -z "$F" ]]; then
    _LOG_FILE=
    return 0
  fi
  F=$(_expand_tilde "$F")
  D=$(dirname "$F")
  if [[ ! -d "$D" ]] && ! mkdir -p "$D" 2>/dev/null; then
    __show_warn "cannot create log directory: ${D} (logging to stdout)"
    _LOG_FILE=
    return 1
  fi
  if ! : >> "$F" 2>/dev/null; then
    __show_warn "cannot write log file: ${F} (logging to stdout)"
    _LOG_FILE=
    return 1
  fi
  _LOG_FILE=$F
  return 0
}
#}}}

# _log <LEVEL> <ENTRY|-> <MSG...>
_log() { #{{{
  local LEVEL=$1 ENTRY=$2
  shift 2
  local MSG LINE
  MSG=$(_sanitize "$*")
  if [[ "$ENTRY" == '-' ]]; then
    printf -v LINE '%s [%-5s] %s' "$(_timestamp)" "$LEVEL" "$MSG"
  else
    printf -v LINE '%s [%-5s] [%s] %s' "$(_timestamp)" "$LEVEL" "$ENTRY" "$MSG"
  fi
  if [[ -n "$_LOG_FILE" ]]; then
    printf '%s\n' "$LINE" >> "$_LOG_FILE"
  else
    printf '%s\n' "$LINE"
  fi
  return 0
}
#}}}

_log_info()  { _log 'INFO'  "$@"; }
_log_warn()  { _log 'WARN'  "$@"; }
_log_error() { _log 'ERROR' "$@"; }

# -v / -vv 指定時のみ標準エラー出力に出す (SPECS 3.2)
_debug() { #{{{
  (( _VERBOSE >= 1 )) || return 0
  printf '%s [DEBUG] %s\n' "$(_timestamp)" "$(_sanitize "$*")" >&2
  return 0
}
#}}}

_debug2() { #{{{
  (( _VERBOSE >= 2 )) || return 0
  printf '%s [DEBUG] %s\n' "$(_timestamp)" "$(_sanitize "$*")" >&2
  return 0
}
#}}}
