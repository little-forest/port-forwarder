C_GREEN=
C_YELLOW=
C_RED=
C_GREY=
C_CYAN=
#}}}

#-------------------------------------------------------------------------------
#- common functions ------------------------------------------------------------
#{{{
__setup() { #{{{
  tty -s || _NO_TTY=yes
}
#}}}

# Emit ANSI SGR sequences directly instead of calling tput.
# tput needed 172 forks here (~0.8s on macOS), and its terminfo lookup was not
# actually more portable: on 8-color entries (linux, ansi, rxvt, putty) the
# bright colors 8-15 came out as broken sequences (setaf 9 -> ESC[39m, which
# resets the foreground instead of turning it red), and terminals missing from
# the system terminfo DB (kitty, alacritty, ghostty, wezterm, foot) produced
# no color at all. The capability probe tput did provide is replaced by the
# TERM / NO_COLOR check below.
__setup_color() { #{{{
  local I NAME NUM SGR
  local ESC=$'\033'

  # terminals that cannot show color
  case "${TERM:-dumb}" in
    dumb|*-mono|vt100|vt102|vt220) return 0 ;;
  esac
  # https://no-color.org/
  [[ -n "$NO_COLOR" ]] && return 0

  local COLOR_MAP=(\
    BLACK 0 MAROON 1 GREEN 2 OLIVE 3 NAVY 4 PURPLE 5 TEAL 6 SILVER 7 GREY 8 \
    RED 9 LIME 10 YELLOW 11 BLUE 12 FUCHSIA 13 AQUA 14 WHITE 15 \
    MAGENTA 5 CYAN 6 PINK 218 ORANGE 214 DARK_ORANGE3 166 \
  )

  C_OFF="${ESC}[0m"   # Reset attribute
  # shellcheck disable=SC2034
  C_BOLD="${ESC}[1m"  # Bold mode
  # shellcheck disable=SC2034
  C_REV="${ESC}[7m"   # Reverse mode
  # shellcheck disable=SC2034
  C_UL="${ESC}[4m"    # Underline mode

  for ((I=0; I<${#COLOR_MAP[@]}; I+=2)); do
    NAME=${COLOR_MAP[$I]}
    NUM=${COLOR_MAP[(($I + 1))]}
    # SGR foreground: 0-7 -> 30-37 / 8-15 -> 90-97 / 16-255 -> 38;5;n
    if (( NUM < 8 )); then
      SGR="${ESC}[$(( 30 + NUM ))m"
    elif (( NUM < 16 )); then
      SGR="${ESC}[$(( 82 + NUM ))m"
    else
      SGR="${ESC}[38;5;${NUM}m"
    fi
    printf -v "C_${NAME}"   '%s' "$SGR"
    printf -v "C_B_${NAME}" '%s' "${C_BOLD}${SGR}"
    printf -v "C_U_${NAME}" '%s' "${C_UL}${SGR}"
    printf -v "C_R_${NAME}" '%s' "${C_BOLD}${C_REV}${SGR}"
  done
}
#}}}

__script_end() { #{{{
  local FUNC
  while read -r FUNC; do
    $FUNC
  done < <(declare -F | sed -e 's/^declare -f //' | grep -E '^__?script_end_.+' | sort)
}
trap '__script_end' EXIT
#}}}

__show_info() { #{{{
  [[ -n "${__SILENT}" ]] && return
  [[ "$1" == "-n" ]] && echo -en "${C_CYAN}${2}${C_OFF}" || echo -e "${C_CYAN}${1}${C_OFF}"
}
#}}}

__show_error() { #{{{
  echo -e "[${C_RED} ERROR ${C_OFF}] $*" >&2
}
#}}}

__show_warn() { #{{{
  [[ -n "${__SILENT}" ]] && return
  echo -e "[${C_YELLOW} WARN ${C_OFF}] $*" >&2
}
#}}}

__error_end() { #{{{
  __show_error "$*"; exit 1
}
#}}}

# accessor kept for compatibility with the shared boilerplate; the path itself
# is fixed at script scope in __TMP_BASE
__get_tmp_base() { #{{{
  echo "$__TMP_BASE"
}
#}}}

# shellcheck disable=SC2120  # the -d argument is optional; no caller passes it today
__make_tmp() { #{{{
  # create the base directory lazily, so that runs which never need a temporary
  # file leave nothing behind. -m 700 does not rely on umask being set yet
  [[ -d "$__TMP_BASE" ]] || mkdir -m 700 "$__TMP_BASE" || return 1
  local OPT=()
  [[ "$1" == '-d' ]] && OPT+=("$1")
  OPT+=('-p' "$__TMP_BASE")
  mktemp "${OPT[@]}"
}
#}}}

__script_end_clean_tmp() { #{{{
  [[ -d "$__TMP_BASE" ]] && rm -rf "$__TMP_BASE"
  return 0
}
#}}}
#}}}

#-------------------------------------------------------------------------------
#- utility functions -----------------------------------------------------------
#{{{
# return the current time in epoch seconds
_now() { #{{{
  if [[ -z "$_HAVE_PRINTF_TIME" ]]; then
    if printf '%(%s)T' -1 >/dev/null 2>&1; then _HAVE_PRINTF_TIME=yes; else _HAVE_PRINTF_TIME=no; fi
  fi
  if [[ "$_HAVE_PRINTF_TIME" == yes ]]; then
    printf '%(%s)T\n' -1
  else
    date +%s
  fi
}
#}}}

# timestamp for log output (SPECS 6.5)
_timestamp() { #{{{
  if [[ -z "$_HAVE_PRINTF_TIME" ]]; then
    if printf '%(%s)T' -1 >/dev/null 2>&1; then _HAVE_PRINTF_TIME=yes; else _HAVE_PRINTF_TIME=no; fi
  fi
  if [[ "$_HAVE_PRINTF_TIME" == yes ]]; then
    printf '%(%Y-%m-%dT%H:%M:%S%z)T\n' -1
  else
    date +%Y-%m-%dT%H:%M:%S%z
  fi
}
#}}}

# format elapsed seconds as "2d 04:11" / "05:22" (SPECS 6.1)
_fmt_uptime() { #{{{
  local SEC=$1 D H M
  [[ ! "$SEC" =~ ^[0-9]+$ ]] && { printf '%s\n' '-'; return; }
  D=$(( SEC / 86400 ))
  H=$(( SEC % 86400 / 3600 ))
  M=$(( SEC % 3600 / 60 ))
  if (( D > 0 )); then
    printf '%dd %02d:%02d\n' "$D" "$H" "$M"
  else
    printf '%02d:%02d\n' "$H" "$M"
  fi
}
#}}}

# expand a leading ~ to $HOME
_expand_tilde() { #{{{
  local P=$1
  if [[ "${P:0:1}" == '~' ]]; then
    if (( ${#P} == 1 )); then
      P=$HOME
    elif [[ "${P:1:1}" == '/' ]]; then
      P="${HOME}${P:1}"
    fi
  fi
  printf '%s\n' "$P"
}
#}}}

# whether an array contains a value
_in_array() { #{{{
  local NEEDLE=$1 V
  shift
  for V in "$@"; do
    [[ "$V" == "$NEEDLE" ]] && return 0
  done
  return 1
}
#}}}

# truncate a string wider than the given width with a trailing ... (SPECS 6.2)
_truncate() { #{{{
  local S=$1 W=$2
  if (( ${#S} > W )); then
    printf '%s...\n' "${S:0:$(( W - 3 ))}"
  else
    printf '%s\n' "$S"
  fi
}
#}}}

# replace control characters with spaces and cut the string off at 256 bytes (DESIGN 9)
_sanitize() { #{{{
  local S=$*
  S=${S//[[:cntrl:]]/ }
  # strip leading and trailing whitespace
  S=${S#"${S%%[![:space:]]*}"}
  S=${S%"${S##*[![:space:]]}"}
  (( ${#S} > 256 )) && S=${S:0:256}
  printf '%s\n' "$S"
}
#}}}

# abort with an error message and an exit code (DESIGN 7.1)
_error_exit() { #{{{
  local CODE=$1
  shift
  __show_error "$*"
  exit "$CODE"
}
#}}}

# print the result of an operation on a single line (DESIGN 2.3)
_show_result() { #{{{
  local RESULT=$1 NAME=$2
  shift 2
  [[ -n "$_QUIET" ]] && return 0
  local TAG COLOR
  case "$RESULT" in
    OK)     TAG='  OK  '; COLOR=$C_GREEN ;;
    FAILED) TAG='FAILED'; COLOR=$C_RED ;;
    WARN)   TAG=' WARN '; COLOR=$C_YELLOW ;;
    SKIP)   TAG=' SKIP '; COLOR=$C_GREY ;;
    *)      TAG=$RESULT;  COLOR= ;;
  esac
  printf '[%s%s%s] %-*s %s\n' "$COLOR" "$TAG" "$C_OFF" "$_NAME_WIDTH" "$NAME" "$*"
}
#}}}

# determine the display width from the longest target entry name
_calc_name_width() { #{{{
  local N W=10
  for N in "$@"; do
    (( ${#N} > W )) && W=${#N}
  done
  _NAME_WIDTH=$W
}
#}}}

# --system targets /etc and systemd, which only exist on Linux (SPECS 8 / 9)
_require_linux() { #{{{
  local OS
  OS=$(uname)
  [[ "$OS" == 'Linux' ]] && return 0
  _error_exit "$_EXIT_ERROR" "$(_err_system_not_linux "$OS")"
}
#}}}
#}}}

#-------------------------------------------------------------------------------
#- logging functions -----------------------------------------------------------
#{{{
# determine the log destination; fall back to stdout when it is not writable
_log_init() { #{{{
  local F D
  F=${_GLOBAL[log_file]}
  if [[ -z "$F" ]]; then
    _LOG_FILE=
    return 0
  fi
  F=$(_expand_tilde "$F")
  D=$(dirname "$F")
  if [[ ! -d "$D" ]] && ! mkdir -p "$D" 2>/dev/null; then
    __show_warn "cannot create log directory: ${D} (logging to stdout)"
    _LOG_FILE=
    return 1
  fi
  if ! : >> "$F" 2>/dev/null; then
    __show_warn "cannot write log file: ${F} (logging to stdout)"
    _LOG_FILE=
    return 1
  fi
  _LOG_FILE=$F
  return 0
}
#}}}

# _log <LEVEL> <ENTRY|-> <MSG...>
_log() { #{{{
  local LEVEL=$1 ENTRY=$2
  shift 2
  local MSG LINE
  MSG=$(_sanitize "$*")
  if [[ "$ENTRY" == '-' ]]; then
    printf -v LINE '%s [%-5s] %s' "$(_timestamp)" "$LEVEL" "$MSG"
  else
    printf -v LINE '%s [%-5s] [%s] %s' "$(_timestamp)" "$LEVEL" "$ENTRY" "$MSG"
  fi
  if [[ -n "$_LOG_FILE" ]]; then
    printf '%s\n' "$LINE" >> "$_LOG_FILE"
  else
    printf '%s\n' "$LINE"
  fi
  return 0
}
#}}}

_log_info()  { _log 'INFO'  "$@"; }
_log_warn()  { _log 'WARN'  "$@"; }
_log_error() { _log 'ERROR' "$@"; }

# print to stderr only when -v / -vv is given (SPECS 3.2)
_debug() { #{{{
  (( _VERBOSE >= 1 )) || return 0
  printf '%s [DEBUG] %s\n' "$(_timestamp)" "$(_sanitize "$*")" >&2
  return 0
}
#}}}

_debug2() { #{{{
  (( _VERBOSE >= 2 )) || return 0
  printf '%s [DEBUG] %s\n' "$(_timestamp)" "$(_sanitize "$*")" >&2
  return 0
}
#}}}
#}}}

